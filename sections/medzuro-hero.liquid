{%- comment -%} medzuro build file {%- endcomment -%}
{%- comment -%}
  Medzuro — homepage hero.

  Eyebrow, two-line headline where the second line takes the accent colour,
  body copy, and up to two buttons, with the product image on the right.
  Stacks to image-under-text on mobile.
{%- endcomment -%}

{%- assign s = section.settings -%}

<div class="mz-hero section-{{ section.id }}">
  <div class="{% if s.section_width == 'container' %}page-width{% else %}fullwidth{% endif %}">
    <div class="mz-hero__inner">

      <div class="mz-hero__text">
        {%- if s.eyebrow != blank -%}<span class="mz-hero__eyebrow">{{ s.eyebrow }}</span>{%- endif -%}

        {%- if s.heading != blank or s.heading_accent != blank -%}
          <h1 class="mz-hero__h">
            {%- if s.heading != blank -%}<span class="mz-hero__h1">{{ s.heading }}</span>{%- endif -%}
            {%- if s.heading_accent != blank -%}<span class="mz-hero__h2">{{ s.heading_accent }}</span>{%- endif -%}
          </h1>
        {%- endif -%}

        {%- if s.body != blank -%}<div class="mz-hero__body rte">{{ s.body }}</div>{%- endif -%}

        {%- if s.btn1_text != blank or s.btn2_text != blank -%}
          <div class="mz-hero__actions">
            {%- if s.btn1_text != blank -%}
              <a class="mz-hero__btn mz-hero__btn--solid" href="{{ s.btn1_url | default: '#' }}">{{ s.btn1_text }}</a>
            {%- endif -%}
            {%- if s.btn2_text != blank -%}
              <a class="mz-hero__btn mz-hero__btn--ghost" href="{{ s.btn2_url | default: '#' }}">
                {%- if s.btn2_icon -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"
                       stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                    <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="2.6"/>
                  </svg>
                {%- endif -%}
                {{ s.btn2_text }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      <div class="mz-hero__media">
        {%- if s.image != blank -%}
          {{ s.image | image_url: width: 1400 | image_tag:
             class: 'mz-hero__img', fetchpriority: 'high',
             widths: '500,700,900,1200,1400', sizes: '(max-width: 899px) 92vw, 50vw',
             alt: s.image.alt | default: s.heading }}
        {%- else -%}
          <div class="mz-hero__ph">{{ 'collection-1' | placeholder_svg_tag: 'mz-hero__phsvg' }}</div>
        {%- endif -%}
      </div>

    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} {
    background:{{ s.bg }};
    {%- if s.bg_gradient != blank %}background-image:{{ s.bg_gradient }};{% endif -%}
    padding:{{ s.padding_top }}px 0 {{ s.padding_bottom }}px;
  }
  .section-{{ section.id }} .mz-hero__inner { display:grid; gap:32px; grid-template-columns:1fr; align-items:center; }
  @media (min-width:900px) {
    .section-{{ section.id }} .mz-hero__inner { grid-template-columns:{{ s.text_width }}fr {{ s.image_width }}fr; gap:40px; }
  }

  .section-{{ section.id }} .mz-hero__text { display:flex; flex-direction:column; align-items:flex-start; gap:18px; }
  .section-{{ section.id }} .mz-hero__eyebrow {
    font-size:{{ s.eyebrow_size }}px; font-weight:700; letter-spacing:.16em; text-transform:uppercase; color:{{ s.eyebrow_color }};
  }
  .section-{{ section.id }} .mz-hero__h { margin:0; line-height:1.08; font-size:{{ s.heading_size }}px; letter-spacing:-.02em; }
  .section-{{ section.id }} .mz-hero__h1,
  .section-{{ section.id }} .mz-hero__h2 { display:block; font-weight:700; }
  .section-{{ section.id }} .mz-hero__h1 { color:{{ s.heading_color }}; }
  .section-{{ section.id }} .mz-hero__h2 { color:{{ s.accent }}; }
  .section-{{ section.id }} .mz-hero__body { color:{{ s.body_color }}; font-size:{{ s.body_size }}px; line-height:1.65; max-width:46ch; }
  .section-{{ section.id }} .mz-hero__body p { margin:0; }

  .section-{{ section.id }} .mz-hero__actions { display:flex; flex-wrap:wrap; gap:14px; margin-top:6px; }
  .section-{{ section.id }} .mz-hero__btn {
    display:inline-flex; align-items:center; justify-content:center; gap:9px;
    padding:15px 28px; border-radius:{{ s.btn_radius }}px; text-decoration:none;
    font-weight:700; font-size:13px; letter-spacing:.08em; text-transform:uppercase;
    transition:background .2s ease, color .2s ease, border-color .2s ease;
  }
  .section-{{ section.id }} .mz-hero__btn svg { width:17px; height:17px; flex:0 0 auto; }
  .section-{{ section.id }} .mz-hero__btn--solid { background:{{ s.btn1_bg }}; color:{{ s.btn1_text_color }}; border:2px solid {{ s.btn1_bg }}; }
  .section-{{ section.id }} .mz-hero__btn--solid:hover { background:{{ s.accent }}; border-color:{{ s.accent }}; }
  .section-{{ section.id }} .mz-hero__btn--ghost { background:transparent; color:{{ s.btn2_text_color }}; border:2px solid {{ s.btn2_border }}; }
  .section-{{ section.id }} .mz-hero__btn--ghost:hover { border-color:{{ s.accent }}; color:{{ s.accent }}; }
  .section-{{ section.id }} .mz-hero__btn:focus-visible { outline:2px solid {{ s.accent }}; outline-offset:3px; }

  .section-{{ section.id }} .mz-hero__media { min-width:0; }
  .section-{{ section.id }} .mz-hero__img { width:100%; height:auto; display:block; border-radius:{{ s.image_radius }}px; }
  .section-{{ section.id }} .mz-hero__ph { background:{{ s.ph_bg }}; border-radius:{{ s.image_radius }}px; aspect-ratio:4/3; display:grid; place-items:center; }
  .section-{{ section.id }} .mz-hero__phsvg { width:60%; height:60%; fill:{{ s.body_color }}; opacity:.25; }

  @media (max-width:899px) {
    .section-{{ section.id }} .mz-hero__h { font-size:{{ s.heading_size | times: 62 | divided_by: 100 }}px; }
    .section-{{ section.id }} .mz-hero__media { order:2; }
  }
</style>

{% schema %}
{
  "name": "Medzuro hero",
  "tag": "section",
  "class": "mz-hero-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Your wellness store in Fiji" },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Your wellness store," },
    { "type": "text", "id": "heading_accent", "label": "Heading line 2 (accent colour)", "default": "right here in Fiji." },
    { "type": "richtext", "id": "body", "label": "Body", "default": "<p>Genuine HolyOak supplements, available locally with same-day delivery across most of Suva and local pickup.</p>" },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "container",
      "options": [{ "value": "container", "label": "Contained" }, { "value": "full", "label": "Full width" }] },
    { "type": "header", "content": "Buttons" },
    { "type": "text", "id": "btn1_text", "label": "Button 1 text", "default": "Shop all products" },
    { "type": "url", "id": "btn1_url", "label": "Button 1 link" },
    { "type": "text", "id": "btn2_text", "label": "Button 2 text", "default": "Local pickup & delivery" },
    { "type": "url", "id": "btn2_url", "label": "Button 2 link" },
    { "type": "checkbox", "id": "btn2_icon", "label": "Show pin icon on button 2", "default": true },
    { "type": "range", "id": "btn_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Button radius", "default": 6 },
    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "text_width", "min": 1, "max": 3, "step": 1, "label": "Text column width", "default": 1 },
    { "type": "range", "id": "image_width", "min": 1, "max": 3, "step": 1, "label": "Image column width", "default": 1 },
    { "type": "range", "id": "image_radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image radius", "default": 0 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 5, "unit": "px", "label": "Padding top", "default": 50 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 5, "unit": "px", "label": "Padding bottom", "default": 40 },
    { "type": "header", "content": "Type" },
    { "type": "range", "id": "eyebrow_size", "min": 10, "max": 18, "step": 1, "unit": "px", "label": "Eyebrow size", "default": 12 },
    { "type": "range", "id": "heading_size", "min": 28, "max": 80, "step": 2, "unit": "px", "label": "Heading size", "default": 52 },
    { "type": "range", "id": "body_size", "min": 13, "max": 22, "step": 1, "unit": "px", "label": "Body size", "default": 16 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg", "label": "Background", "default": "#ffffff" },
    { "type": "color_background", "id": "bg_gradient", "label": "Background gradient" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#4f8a3d" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow", "default": "#5a6b82" },
    { "type": "color", "id": "heading_color", "label": "Heading", "default": "#0b1b33" },
    { "type": "color", "id": "body_color", "label": "Body text", "default": "#5a6b82" },
    { "type": "color", "id": "ph_bg", "label": "Image placeholder", "default": "#f5f7fa" },
    { "type": "color", "id": "btn1_bg", "label": "Button 1 background", "default": "#002964" },
    { "type": "color", "id": "btn1_text_color", "label": "Button 1 text", "default": "#ffffff" },
    { "type": "color", "id": "btn2_text_color", "label": "Button 2 text", "default": "#0b1b33" },
    { "type": "color", "id": "btn2_border", "label": "Button 2 border", "default": "#d7dee9" }
  ],
  "presets": [{ "name": "Medzuro hero" }]
}
{% endschema %}
