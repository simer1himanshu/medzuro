/*
 * Medzuro homepage — spec §7 section order.
 * Collections, products, blog and images must still be picked in the
 * theme editor; text content here is a starting draft, all editable.
 */
{
  "sections": {
    "hero_banner": {
      "type": "slideshow",
      "blocks": {
        "slide_1": {
          "type": "image",
          "settings": {
            "hd1": "Fiji's premium wellness, done properly",
            "phbg": "",
            "ialign": "left"
          }
        }
      },
      "block_order": [
        "slide_1"
      ],
      "settings": {
        "section_width": "full",
        "ht": "",
        "htd": 700,
        "htm": 520
      }
    },
    "shop_by_category": {
      "type": "collection-list",
      "blocks": {
        "cat_1": {
          "type": "featured_collection",
          "settings": {
            "collection_name": "Vitamins & Minerals"
          }
        },
        "cat_2": {
          "type": "featured_collection",
          "settings": {
            "collection_name": "Herbal Formulations"
          }
        },
        "cat_3": {
          "type": "featured_collection",
          "settings": {
            "collection_name": "Sports Nutrition"
          }
        },
        "cat_4": {
          "type": "featured_collection",
          "settings": {
            "collection_name": "Daily Wellness"
          }
        }
      },
      "block_order": [
        "cat_1",
        "cat_2",
        "cat_3",
        "cat_4"
      ],
      "settings": {
        "title": "Shop by category",
        "subtitle": "Nutraceuticals, vitamins and wellness essentials",
        "section_width": "container"
      }
    },
    "featured_product": {
      "type": "featured-product",
      "blocks": {
        "fp_title": {
          "type": "title",
          "settings": {}
        },
        "fp_price": {
          "type": "price",
          "settings": {}
        },
        "fp_ras": {
          "type": "ras",
          "settings": {
            "availability": true,
            "sku": true
          }
        },
        "fp_shortdes": {
          "type": "shortdes",
          "settings": {}
        },
        "fp_variants": {
          "type": "variants",
          "settings": {}
        },
        "fp_cta": {
          "type": "cta",
          "settings": {
            "qty_sel": true
          }
        }
      },
      "block_order": [
        "fp_title",
        "fp_price",
        "fp_ras",
        "fp_shortdes",
        "fp_variants",
        "fp_cta"
      ],
      "settings": {
        "section_width": "container"
      }
    },
    "holyoak_collection": {
      "type": "product-slider",
      "settings": {
        "title": "The HolyOak range",
        "subtitle": "Officially imported and authorized for sale in Fiji",
        "section_width": "container"
      }
    },
    "why_medzuro": {
      "type": "store-features",
      "blocks": {
        "f_seller": {
          "type": "text_block",
          "settings": {
            "icons": "at-check-circle",
            "title": "Authorized HolyOak Seller",
            "text": "<p>The official HolyOak distributor in Fiji — every product genuine and traceable.</p>"
          }
        },
        "f_science": {
          "type": "text_block",
          "settings": {
            "icons": "at-flask",
            "title": "Science-backed ingredients",
            "text": "<p>Formulations grounded in published research, not marketing claims.</p>"
          }
        },
        "f_quality": {
          "type": "text_block",
          "settings": {
            "icons": "at-shield-check",
            "title": "Quality promise",
            "text": "<p>Independently tested batches, cold-chain storage and full traceability.</p>"
          }
        }
      },
      "block_order": [
        "f_seller",
        "f_science",
        "f_quality"
      ],
      "settings": {
        "title": "Why choose Medzuro",
        "subtitle": "",
        "section_width": "container"
      }
    },
    "counters": {
      "type": "medzuro-counters",
      "blocks": {
        "c_sold": {
          "type": "counter",
          "settings": {
            "value": 22500,
            "suffix": "+",
            "label": "Products Sold"
          }
        },
        "c_countries": {
          "type": "counter",
          "settings": {
            "value": 3,
            "suffix": "",
            "label": "Countries Served"
          }
        },
        "c_customers": {
          "type": "counter",
          "settings": {
            "value": 8000,
            "suffix": "+",
            "label": "Happy Customers"
          }
        }
      },
      "block_order": [
        "c_sold",
        "c_countries",
        "c_customers"
      ],
      "settings": {
        "title": "Trusted across Fiji",
        "bg_color": "#f7f7f5"
      }
    },
    "reviews": {
      "type": "quotes",
      "blocks": {
        "q1": {
          "type": "quote",
          "settings": {
            "quote": "<p>Genuine HolyOak products and it arrived in Suva the same day.</p>",
            "author": "Verified customer",
            "display_rat": true,
            "rating": 5
          }
        },
        "q2": {
          "type": "quote",
          "settings": {
            "quote": "<p>Clear ingredient information — finally a wellness store that explains what is in the bottle.</p>",
            "author": "Verified customer",
            "display_rat": true,
            "rating": 5
          }
        }
      },
      "block_order": [
        "q1",
        "q2"
      ],
      "settings": {
        "title": "What our customers say"
      }
    },
    "blog": {
      "type": "featured-blog",
      "settings": {
        "title": "Wellness journal",
        "subtitle": "Nutrition, lifestyle and wellness guidance"
      }
    },
    "newsletter": {
      "type": "newsletter",
      "settings": {
        "title": "Stay well informed",
        "subtitle": "Wellness tips and early access to new arrivals."
      }
    },
    "instagram": {
      "type": "instagram-shop",
      "settings": {
        "title": "@medzuroretail",
        "section_width": "container"
      }
    },
    "faq": {
      "type": "faq",
      "blocks": {
        "q_auth": {
          "type": "faqs",
          "settings": {
            "title": "Are your HolyOak products genuine?",
            "answer": "<p>Yes. Medzuro Retail is the authorized seller of HolyOak products in Fiji, importing directly from the manufacturer.</p>"
          }
        },
        "q_deliv": {
          "type": "faqs",
          "settings": {
            "title": "How fast is delivery?",
            "answer": "<p>90% of Suva deliveries arrive the same day. Most other Fiji cities arrive within 2–3 business days.</p>"
          }
        },
        "q_pickup": {
          "type": "faqs",
          "settings": {
            "title": "Can I collect my order in store?",
            "answer": "<p>Yes — choose Store Pickup at checkout and we will confirm your nearest location and collection time.</p>"
          }
        },
        "q_soon": {
          "type": "faqs",
          "settings": {
            "title": "When will more products be available?",
            "answer": "<p>Products marked Coming Soon can be joined to a notify list — we will email you the moment they land.</p>"
          }
        }
      },
      "block_order": [
        "q_auth",
        "q_deliv",
        "q_pickup",
        "q_soon"
      ],
      "settings": {
        "title": "Frequently asked questions"
      }
    }
  },
  "order": [
    "hero_banner",
    "shop_by_category",
    "featured_product",
    "holyoak_collection",
    "why_medzuro",
    "counters",
    "reviews",
    "blog",
    "newsletter",
    "instagram",
    "faq"
  ]
}
