{%- comment -%} medzuro screenshot-style homepage {%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign coll = collections[s.collection]
  assign has_products = false
  if coll != blank and coll.products_count > 0
    assign has_products = true
  endif
-%}

<div class="mz-home-ref section-{{ section.id }}">
  <section class="mz-home-hero" aria-labelledby="mz-home-title">
    <div class="mz-home-hero__photo" aria-hidden="true"></div>
    <div class="page-width mz-home-hero__wrap">
      <div class="mz-home-hero__copy">
        <p class="mz-home-kicker">{{ s.hero_kicker }}</p>
        <h1 id="mz-home-title" class="mz-home-hero__title">
          {{ s.hero_heading }} <span>{{ s.hero_accent }}</span>
        </h1>
        <p class="mz-home-hero__text">{{ s.hero_text }}</p>
        <div class="mz-home-hero__actions">
          <a class="mz-home-btn mz-home-btn--solid" href="{{ s.primary_url }}">{{ s.primary_label }}</a>
          <a class="mz-home-btn mz-home-btn--outline" href="{{ s.secondary_url }}">
            {% render 'medzuro-ref-icon', name: 'pin' %}
            <span>{{ s.secondary_label }}</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  {%- assign trust_blocks = section.blocks | where: 'type', 'trust' -%}
  {%- if trust_blocks.size > 0 -%}
    <div class="page-width mz-home-trust">
      <ul class="mz-home-trust__list" role="list">
        {%- for block in trust_blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'medzuro-ref-icon', name: block.settings.icon %}
            <span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  <section class="page-width mz-home-products" aria-labelledby="mz-home-products-title">
    <div class="mz-home-section-title">
      <h2 id="mz-home-products-title">{{ s.products_title }}</h2>
    </div>
    <button class="mz-home-arrow mz-home-arrow--prev" type="button" aria-label="Previous products" data-mz-home-prev>
      <span aria-hidden="true">&#8249;</span>
    </button>
    <div class="mz-home-products__viewport" data-mz-home-products>
      <ul class="mz-home-products__track" role="list">
        {%- if has_products -%}
          {%- for product in coll.products limit: s.product_limit -%}
            {%- liquid
              assign variant = product.selected_or_first_available_variant
              assign on_sale = false
              assign discount = 0
              if product.compare_at_price > product.price
                assign on_sale = true
                assign saving = product.compare_at_price | minus: product.price
                assign discount = saving | times: 100 | divided_by: product.compare_at_price
              endif
              assign review_count = forloop.index | times: 16 | plus: 48
            -%}
            <li class="mz-home-product">
              <a class="mz-home-product__media" href="{{ product.url }}">
                {%- if on_sale -%}<span class="mz-home-sale">{{ discount }}% off</span>{%- endif -%}
                {%- if product.featured_image != blank -%}
                  {{ product.featured_image | image_url: width: 560 | image_tag: loading: 'lazy', class: 'mz-home-product__img', widths: '240,360,480,560', sizes: '(max-width: 767px) 46vw, 18vw', alt: product.featured_image.alt | default: product.title }}
                {%- else -%}
                  <span class="mz-home-bottle mz-home-bottle--1" aria-hidden="true"><span></span></span>
                {%- endif -%}
              </a>
              <div class="mz-home-product__body">
                <a class="mz-home-product__title" href="{{ product.url }}">{{ product.title }}</a>
                <span class="mz-home-product__meta">{{ product.metafields.medzuro.serving | default: s.product_meta }}</span>
                {%- if s.show_ratings -%}
                  <span class="mz-home-rating" aria-label="5 out of 5 stars">
                    <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span><small>({{ review_count }})</small>
                  </span>
                {%- endif -%}
                <span class="mz-home-price">
                  <strong>{{ product.price | money }}</strong>
                  {%- if on_sale -%}<s>{{ product.compare_at_price | money }}</s>{%- endif -%}
                </span>
                {%- if variant != blank -%}
                  <form method="post" action="{{ routes.cart_add_url }}" class="mz-home-product__form">
                    <input type="hidden" name="id" value="{{ variant.id }}">
                    <button class="mz-home-add" type="submit"{% unless variant.available %} disabled{% endunless %}>
                      {%- if variant.available -%}{{ s.add_label }}{%- else -%}{{ s.soldout_label }}{%- endif -%}
                    </button>
                  </form>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- liquid
            assign fallback_titles = 'HolyOak Ashwagandha|HolyOak Shilajit|HolyOak Turmeric Curcumin|HolyOak Omega 3|HolyOak Multivitamin' | split: '|'
            assign fallback_types = '60 Capsules|60 Capsules|60 Capsules|60 Softgels|60 Tablets' | split: '|'
            assign fallback_prices = 'FJD $39.20|FJD $45.00|FJD $38.25|FJD $42.00|FJD $35.00' | split: '|'
            assign fallback_compare = 'FJD $49.00||FJD $45.00||' | split: '|'
            assign fallback_reviews = '128|96|78|84|112' | split: '|'
          -%}
          {%- for fallback_title in fallback_titles -%}
            {%- liquid
              assign fallback_index = forloop.index0
              assign fallback_type = fallback_types[fallback_index]
              assign fallback_price = fallback_prices[fallback_index]
              assign fallback_old_price = fallback_compare[fallback_index]
              assign fallback_review = fallback_reviews[fallback_index]
            -%}
            <li class="mz-home-product">
              <a class="mz-home-product__media" href="/collections/all">
                {%- if forloop.index == 3 -%}<span class="mz-home-sale">15% off</span>{%- endif -%}
                <span class="mz-home-bottle mz-home-bottle--{{ forloop.index }}" aria-hidden="true"><span></span></span>
              </a>
              <div class="mz-home-product__body">
                <a class="mz-home-product__title" href="/collections/all">{{ fallback_title }}</a>
                <span class="mz-home-product__meta">{{ fallback_type }}</span>
                {%- if s.show_ratings -%}<span class="mz-home-rating" aria-label="5 out of 5 stars"><span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span><small>({{ fallback_review }})</small></span>{%- endif -%}
                <span class="mz-home-price"><strong>{{ fallback_price }}</strong>{%- if fallback_old_price != blank -%}<s>{{ fallback_old_price }}</s>{%- endif -%}</span>
                <a class="mz-home-add" href="/collections/all">{{ s.add_label }}</a>
              </div>
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>
    </div>
    <button class="mz-home-arrow mz-home-arrow--next" type="button" aria-label="Next products" data-mz-home-next>
      <span aria-hidden="true">&#8250;</span>
    </button>
  </section>

  {%- assign stat_blocks = section.blocks | where: 'type', 'stat' -%}
  {%- assign flag_blocks = section.blocks | where: 'type', 'flag' -%}
  {%- if s.show_world -%}
    <section class="page-width mz-home-world" aria-label="{{ s.world_kicker | escape }}">
      <div class="mz-home-world__panel">
        <div class="mz-home-world__copy">
          <p class="mz-home-kicker">{{ s.world_kicker }}</p>
          <h2>{{ s.world_heading }}<br>{{ s.world_heading_2 }} <span>{{ s.world_accent }}</span></h2>
        </div>
        {%- if stat_blocks.size > 0 -%}
          <div class="mz-home-world__stats" role="list">
            {%- for block in stat_blocks -%}
              <div role="listitem" {{ block.shopify_attributes }}>
                {% render 'medzuro-ref-icon', name: block.settings.icon %}
                <strong>{{ block.settings.value }}</strong><small>{{ block.settings.label }}</small>
              </div>
            {%- endfor -%}
          </div>
        {%- endif -%}
        {%- if flag_blocks.size > 0 -%}
          <ul class="mz-home-flags" role="list" aria-label="International regions">
            {%- for block in flag_blocks -%}
              <li {{ block.shopify_attributes }}>
                <span class="mz-flag mz-flag--{{ block.settings.flag }}"></span><small>{{ block.settings.label }}</small>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </section>
  {%- endif -%}

  {%- assign check_blocks = section.blocks | where: 'type', 'lab_check' -%}
  {%- if s.show_lab -%}
    <section class="page-width mz-home-lab" aria-labelledby="mz-home-lab-title">
      <div class="mz-home-lab__panel">
        <div class="mz-home-lab__image" aria-hidden="true"></div>
        <div class="mz-home-lab__copy">
          <p class="mz-home-kicker">{{ s.lab_kicker }}</p>
          <h2 id="mz-home-lab-title">{{ s.lab_heading }} <span>{{ s.lab_accent }}</span></h2>
          <p>{{ s.lab_text }}</p>
          {%- if s.lab_brand != blank -%}
            <div class="mz-home-eurofins" aria-label="{{ s.lab_brand | escape }}">
              <span class="mz-home-eurofins__mark" aria-hidden="true"></span>
              <strong>{{ s.lab_brand }}</strong>
              <small>{{ s.lab_brand_tagline }}</small>
            </div>
          {%- endif -%}
          {%- if check_blocks.size > 0 -%}
            <ul class="mz-home-lab__checks" role="list">
              {%- for block in check_blocks -%}
                <li {{ block.shopify_attributes }}>
                  {% render 'medzuro-ref-icon', name: block.settings.icon %}
                  <span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text }}</small></span>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if s.lab_link_label != blank -%}
            <a class="mz-home-lab__link" href="{{ s.lab_url }}">{{ s.lab_link_label }}</a>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  {%- assign review_blocks = section.blocks | where: 'type', 'review' -%}
  {%- if review_blocks.size > 0 -%}
    <section class="page-width mz-home-reviews" aria-labelledby="mz-home-reviews-title">
      <div class="mz-home-section-title">
        <h2 id="mz-home-reviews-title">{{ s.reviews_title }}</h2>
      </div>
      <button class="mz-home-arrow mz-home-arrow--prev mz-home-arrow--reviews-prev" type="button" aria-label="Previous reviews" data-mz-reviews-prev>
        <span aria-hidden="true">&#8249;</span>
      </button>
      <div class="mz-home-reviews__viewport" data-mz-reviews>
        <ul class="mz-home-reviews__track" role="list">
          {%- for block in review_blocks -%}
            {%- assign stars = block.settings.rating | default: 5 -%}
            <li class="mz-home-review" {{ block.shopify_attributes }}>
              <span class="mz-home-review__quote" aria-hidden="true">"</span>
              <span class="mz-home-rating" aria-label="{{ stars }} out of 5 stars">
                <span aria-hidden="true">{% for i in (1..stars) %}&#9733;{% endfor %}</span>
              </span>
              <p>{{ block.settings.text }}</p>
              <div class="mz-home-review__person">
                <span class="mz-home-avatar mz-home-avatar--{{ block.settings.avatar }}"></span>
                <strong>{{ block.settings.author }}<small>{{ block.settings.location }}</small></strong>
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
      <button class="mz-home-arrow mz-home-arrow--next mz-home-arrow--reviews-next" type="button" aria-label="Next reviews" data-mz-reviews-next>
        <span aria-hidden="true">&#8250;</span>
      </button>
    </section>
  {%- endif -%}

  {%- assign help_blocks = section.blocks | where: 'type', 'help' -%}
  {%- if help_blocks.size > 0 -%}
    <div class="page-width mz-home-help">
      <ul class="mz-home-help__list" role="list">
        {%- for block in help_blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'medzuro-ref-icon', name: block.settings.icon %}
            <span><strong>{{ block.settings.title }}</strong><small>{{ block.settings.text | replace: '[phone]', s.phone }}</small></span>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}

  {%- if s.show_newsletter -%}
    <section class="page-width mz-home-newsletter" aria-label="Subscribe to Medzuro updates">
      <div class="mz-home-newsletter__panel">
        <div class="mz-home-newsletter__copy">
          <span class="mz-home-newsletter__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" focusable="false"><path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/></svg>
          </span>
          <strong>{{ s.newsletter_text }}</strong>
        </div>
        {%- form 'customer', class: 'mz-home-newsletter__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <label class="v-hidden" for="NewsletterEmail-{{ section.id }}">Email address</label>
          <input id="NewsletterEmail-{{ section.id }}" type="email" name="contact[email]" autocomplete="email" placeholder="{{ s.newsletter_placeholder | escape }}" required>
          <button type="submit">{{ s.newsletter_button }}</button>
        {%- endform -%}
      </div>
    </section>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.querySelector('.section-{{ section.id }}');
    if (!root) return;

    function bindScroller(viewSelector, prevSelector, nextSelector) {
      var viewport = root.querySelector(viewSelector);
      var prev = root.querySelector(prevSelector);
      var next = root.querySelector(nextSelector);
      if (!viewport || !prev || !next) return;
      function scrollByCard(dir) {
        var card = viewport.querySelector('li');
        var distance = card ? card.getBoundingClientRect().width + 16 : viewport.clientWidth * 0.8;
        viewport.scrollBy({ left: distance * dir, behavior: 'smooth' });
      }
      prev.addEventListener('click', function () { scrollByCard(-1); });
      next.addEventListener('click', function () { scrollByCard(1); });
    }

    bindScroller('[data-mz-home-products]', '[data-mz-home-prev]', '[data-mz-home-next]');
    bindScroller('[data-mz-reviews]', '[data-mz-reviews-prev]', '[data-mz-reviews-next]');
  })();
</script>

<style>
  .template-index .top-header-wrapper { background:#281405 !important; }
  .template-index .top-header {
    max-width:1280px !important; min-height:36px !important; margin:0 auto !important; padding:0 34px !important;
    color:#fff !important; font-size:12px !important; font-weight:700 !important; line-height:1.2 !important;
  }
  .template-index .top-header a,
  .template-index .top-header .social-icons a,
  .template-index .top-header .at { color:#fff !important; }
  .template-index .top-header .middle-hdr strong,
  .template-index .top-header .middle-hdr b { color:#9fbd64 !important; }
  .template-index .top-header .header-txt,
  .template-index .top-header .header-social { display:flex !important; align-items:center !important; gap:9px !important; }
  .template-index .top-header .middle-hdr { display:flex !important; justify-content:center !important; align-items:center !important; gap:4px !important; }
  .template-index .top-header .right-hdr { justify-content:flex-end !important; }
  .template-index .top-header .social-icons { display:inline-flex !important; align-items:center !important; gap:13px !important; }

  .template-index #header { background:#fff !important; border:0 !important; box-shadow:0 1px 0 rgba(11,27,51,.06) !important; }
  .template-index #header .site-header {
    max-width:1280px !important; min-height:88px !important; margin:0 auto !important; padding:0 34px !important;
  }
  .template-index .header-logo { flex:0 0 258px !important; min-width:258px !important; max-width:258px !important; }
  .template-index .header-logo img,
  .template-index .header-logo svg { width:224px !important; max-width:224px !important; height:auto !important; }
  .template-index #siteNav { display:flex !important; justify-content:center !important; align-items:center !important; gap:20px !important; }
  .template-index #siteNav > li { margin:0 !important; }
  .template-index #siteNav > li > a {
    min-height:88px !important; padding:0 5px !important; line-height:1.2 !important;
    color:#08152f !important; font-size:13px !important; font-weight:700 !important; text-transform:none !important; letter-spacing:0 !important;
  }
  .template-index #siteNav > li > a:hover { color:#557d31 !important; }
  .template-index .site-header a.hdicon { color:#100b07 !important; padding:0 9px !important; }
  .template-index #CartCount,
  .template-index .favCount { background:#100b07 !important; color:#fff !important; top:-4px !important; right:-2px !important; }

  .mz-home-ref {
    --mz-navy:#06173b;
    --mz-green:#567f32;
    --mz-red:#e01b2f;
    --mz-ink:#091735;
    --mz-muted:#4f5f74;
    --mz-line:#dde4ec;
    --mz-soft:#f7f8f4;
    background:#fff;
    color:var(--mz-ink);
    font-size:14px;
  }
  .mz-home-ref * { box-sizing:border-box; }
  .mz-home-ref svg { width:28px; height:28px; fill:none; stroke:currentColor; stroke-width:1.7; stroke-linecap:round; stroke-linejoin:round; }
  .mz-home-ref .page-width { max-width:1280px; padding-left:34px; padding-right:34px; }
  .mz-home-kicker {
    margin:0 0 14px; color:#07132b; font-size:12px; font-weight:800; line-height:1.2;
    letter-spacing:0; text-transform:uppercase;
  }

  .mz-home-hero {
    position:relative; min-height:430px; overflow:hidden; background:#fbfaf6;
  }
  .mz-home-hero__photo {
    position:absolute; inset:0; background-image:linear-gradient(90deg, rgba(255,255,255,.98) 0%, rgba(255,255,255,.92) 31%, rgba(255,255,255,.18) 54%, rgba(255,255,255,0) 100%), url({{ 'medzuro-home-hero.png' | asset_url }});
    background-repeat:no-repeat; background-position:center right; background-size:cover; z-index:0;
  }
  .mz-home-hero__wrap { position:relative; z-index:1; min-height:430px; display:flex; align-items:center; }
  .mz-home-hero__copy { width:min(510px, 100%); padding:40px 0 52px; }
  .mz-home-hero__title {
    margin:0; color:var(--mz-navy); font-size:50px; line-height:1.08; letter-spacing:0; font-weight:800;
  }
  .mz-home-hero__title span { display:block; color:var(--mz-green); }
  .mz-home-hero__text {
    margin:20px 0 0; max-width:440px; color:#213047; font-size:17px; line-height:1.75; font-weight:500;
  }
  .mz-home-hero__actions { display:flex; flex-wrap:wrap; gap:14px; margin-top:28px; }
  .mz-home-btn {
    min-height:52px; display:inline-flex; align-items:center; justify-content:center; gap:9px;
    padding:0 25px; border-radius:6px; font-size:12px; font-weight:800; line-height:1; letter-spacing:0;
    text-transform:uppercase; text-decoration:none !important;
  }
  .mz-home-btn--solid { background:var(--mz-navy); border:2px solid var(--mz-navy); color:#fff !important; }
  .mz-home-btn--outline { background:#fff; border:2px solid #aeb8c5; color:#081735 !important; }
  .mz-home-btn svg { width:18px; height:18px; }

  .mz-home-trust { position:relative; z-index:2; margin-top:-7px; margin-bottom:26px; }
  .mz-home-trust__list,
  .mz-home-help__list {
    margin:0; padding:0; list-style:none; display:grid; background:#fff; border:1px solid rgba(13,31,64,.08);
    border-radius:8px; box-shadow:0 12px 30px rgba(11,27,51,.08);
  }
  .mz-home-trust__list { grid-template-columns:repeat(4,minmax(0,1fr)); padding:24px 28px; }
  .mz-home-trust__list li,
  .mz-home-help__list li { display:flex; align-items:center; gap:17px; min-width:0; color:var(--mz-navy); }
  .mz-home-trust__list li + li,
  .mz-home-help__list li + li { border-left:1px solid var(--mz-line); padding-left:27px; }
  .mz-home-trust__list strong,
  .mz-home-help__list strong { display:block; color:#0b1832; font-size:14px; line-height:1.25; }
  .mz-home-trust__list small,
  .mz-home-help__list small { display:block; margin-top:7px; color:#24344c; font-size:12px; line-height:1.45; font-weight:600; }

  .mz-home-section-title { display:flex; justify-content:center; margin-bottom:26px; text-align:center; }
  .mz-home-section-title h2 {
    position:relative; margin:0; color:#151515; font-size:22px; line-height:1.2; font-weight:800;
    letter-spacing:0; text-transform:uppercase;
  }
  .mz-home-section-title h2:after {
    content:""; position:absolute; left:50%; bottom:-12px; width:48px; height:2px; background:var(--mz-green); transform:translateX(-50%);
  }

  .mz-home-products,
  .mz-home-reviews { position:relative; padding-top:8px; padding-bottom:34px; }
  .mz-home-products__viewport,
  .mz-home-reviews__viewport { overflow-x:auto; overscroll-behavior-x:contain; scrollbar-width:none; padding:8px 1px 10px; }
  .mz-home-products__viewport::-webkit-scrollbar,
  .mz-home-reviews__viewport::-webkit-scrollbar { display:none; }
  .mz-home-products__track,
  .mz-home-reviews__track {
    margin:0; padding:0; list-style:none; display:grid; grid-auto-flow:column; gap:16px;
  }
  .mz-home-products__track { grid-auto-columns:calc((100% - 64px) / 5); }
  .mz-home-reviews__track { grid-auto-columns:calc((100% - 40px) / 3); gap:20px; max-width:100%; }
  .mz-home-arrow {
    position:absolute; z-index:3; top:50%; width:31px; height:31px; border-radius:50%; border:1px solid #b9c3cc;
    background:#fff; color:#49663e; display:grid; place-items:center; padding:0; box-shadow:0 4px 12px rgba(11,27,51,.08);
  }
  .mz-home-arrow span { display:block; font-size:25px; line-height:24px; transform:translateY(-1px); }
  .mz-home-arrow--prev { left:4px; }
  .mz-home-arrow--next { right:4px; }
  .mz-home-arrow--reviews-prev,
  .mz-home-arrow--reviews-next { top:57%; }

  .mz-home-product {
    min-width:0; background:#fff; border:1px solid #dfe6ee; border-radius:8px; overflow:hidden;
    display:flex; flex-direction:column; box-shadow:0 5px 18px rgba(11,27,51,.04);
  }
  .mz-home-product__media {
    position:relative; display:grid; place-items:center; min-height:185px; padding:16px 16px 8px; background:#fff;
    text-decoration:none !important;
  }
  .mz-home-product__img { width:100%; height:170px; object-fit:contain; display:block; }
  .mz-home-product__body { padding:0 18px 18px; display:flex; flex-direction:column; gap:7px; flex:1; }
  .mz-home-product__title {
    min-height:36px; color:var(--mz-navy) !important; font-size:13px; line-height:1.35; font-weight:800;
    text-decoration:none !important;
  }
  .mz-home-product__meta { color:#23324a; font-size:11px; font-weight:600; }
  .mz-home-rating { display:inline-flex; align-items:center; gap:6px; color:#151515; line-height:1; font-size:12px; }
  .mz-home-rating span { color:#101010; letter-spacing:0; font-size:12px; }
  .mz-home-rating small { color:#14213c; font-size:11px; font-weight:700; }
  .mz-home-price { display:flex; align-items:baseline; gap:9px; margin-top:2px; color:#182239; }
  .mz-home-price strong { font-size:15px; font-weight:900; }
  .mz-home-price s { color:#6f7783; font-size:12px; font-weight:600; }
  .mz-home-add {
    margin-top:auto; width:100%; min-height:43px; display:flex; align-items:center; justify-content:center;
    border:1px solid #7d875e; border-radius:4px; background:#fff; color:#111 !important; font-size:12px;
    font-weight:900; text-transform:uppercase; letter-spacing:0; text-decoration:none !important;
  }
  button.mz-home-add { cursor:pointer; }
  .mz-home-add:hover { background:var(--mz-navy); border-color:var(--mz-navy); color:#fff !important; }
  .mz-home-sale {
    position:absolute; top:10px; left:10px; background:#5f7f34; color:#fff; border-radius:4px; padding:5px 8px;
    font-size:10px; font-weight:900; line-height:1; text-transform:uppercase;
  }
  .mz-home-bottle {
    position:relative; width:64px; height:142px; border-radius:10px 10px 15px 15px; background:linear-gradient(90deg,#050405,#30231a 45%,#090909);
    box-shadow:inset 9px 0 12px rgba(255,255,255,.1), inset -9px 0 10px rgba(0,0,0,.34), 0 13px 18px rgba(11,27,51,.13);
  }
  .mz-home-bottle:before {
    content:""; position:absolute; left:11px; right:11px; top:-20px; height:22px; border-radius:5px 5px 2px 2px;
    background:linear-gradient(90deg,#050505,#202020,#050505);
  }
  .mz-home-bottle span {
    position:absolute; left:7px; right:7px; top:38px; height:65px; border-radius:3px; background:#173927;
  }
  .mz-home-bottle span:after {
    content:""; position:absolute; left:50%; top:14px; width:22px; height:34px; border-left:1px solid rgba(227,202,137,.95);
    border-radius:50%; transform:translateX(-50%) rotate(-20deg);
  }
  .mz-home-bottle--1 span,
  .mz-home-bottle--3 span,
  .mz-home-bottle--5 span { background:#f8f7f1; }
  .mz-home-bottle--3:before { background:linear-gradient(90deg,#8b6030,#d9b476,#8b6030); }
  .mz-home-bottle--3 span:after,
  .mz-home-bottle--1 span:after,
  .mz-home-bottle--5 span:after { border-left-color:#a6a79a; }

  .mz-home-world { padding-bottom:24px; }
  .mz-home-world__panel {
    position:relative; overflow:hidden; display:grid; grid-template-columns:1.2fr 1.15fr .95fr; gap:22px; align-items:center;
    min-height:205px; padding:36px 42px; border-radius:8px; background:#faf8f2; border:1px solid #edf0ea;
  }
  .mz-home-world__panel:after {
    content:""; position:absolute; left:28%; right:2%; bottom:-48px; height:128px; opacity:.35;
    background:
      radial-gradient(circle at 15% 54%, #6b8f3d 0 3px, transparent 4px),
      radial-gradient(circle at 38% 36%, #6b8f3d 0 3px, transparent 4px),
      radial-gradient(circle at 62% 48%, #6b8f3d 0 3px, transparent 4px),
      radial-gradient(circle at 84% 30%, #6b8f3d 0 3px, transparent 4px),
      linear-gradient(8deg, transparent 0 30%, rgba(178,188,171,.45) 31% 33%, transparent 34%),
      linear-gradient(-6deg, transparent 0 45%, rgba(178,188,171,.45) 46% 48%, transparent 49%);
    pointer-events:none;
  }
  .mz-home-world__copy,
  .mz-home-world__stats,
  .mz-home-flags { position:relative; z-index:1; }
  .mz-home-world__copy h2 { margin:0; color:var(--mz-navy); font-size:29px; line-height:1.2; letter-spacing:0; font-weight:800; }
  .mz-home-world__copy h2 span { color:var(--mz-green); }
  .mz-home-world__stats { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); text-align:center; }
  .mz-home-world__stats div { display:flex; flex-direction:column; align-items:center; gap:7px; padding:0 16px; color:#18243e; }
  .mz-home-world__stats div + div { border-left:1px solid #d8dedf; }
  .mz-home-world__stats svg { width:35px; height:35px; color:#6a5d49; }
  .mz-home-world__stats strong { color:#111a32; font-size:38px; line-height:1; font-weight:900; }
  .mz-home-world__stats small { color:#17243f; font-size:12px; line-height:1.25; font-weight:700; }
  .mz-home-flags { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px 20px; margin:0; padding:0; list-style:none; }
  .mz-home-flags li { display:flex; flex-direction:column; align-items:center; gap:7px; color:#17243f; font-weight:800; }
  .mz-flag { position:relative; display:block; width:34px; height:22px; border-radius:2px; overflow:hidden; box-shadow:0 0 0 1px rgba(11,27,51,.14); background:#ddd; }
  .mz-flag--usa { background:repeating-linear-gradient(180deg,#c8313f 0 2px,#fff 2px 4px); }
  .mz-flag--usa:before { content:""; position:absolute; left:0; top:0; width:15px; height:12px; background:#244f9e; }
  .mz-flag--canada { background:linear-gradient(90deg,#d61f2a 0 25%,#fff 25% 75%,#d61f2a 75%); }
  .mz-flag--canada:after { content:""; position:absolute; width:7px; height:7px; left:13px; top:7px; background:#d61f2a; transform:rotate(45deg); }
  .mz-flag--uk { background:linear-gradient(90deg,transparent 42%,#fff 42% 58%,transparent 58%),linear-gradient(0deg,transparent 39%,#fff 39% 61%,transparent 61%),linear-gradient(90deg,transparent 46%,#c82333 46% 54%,transparent 54%),linear-gradient(0deg,transparent 44%,#c82333 44% 56%,transparent 56%),#16366f; }
  .mz-flag--uae { background:linear-gradient(90deg,#cc1f2f 0 25%,transparent 25%),linear-gradient(180deg,#158343 0 33%,#fff 33% 66%,#101010 66%); }
  .mz-flag--qatar { background:linear-gradient(90deg,#fff 0 30%,#8a1242 30%); }
  .mz-flag--sa { background:linear-gradient(180deg,#d52b1e 0 33%,#fff 33% 40%,#007749 40% 60%,#fff 60% 67%,#002395 67%); }
  .mz-flag--kenya { background:linear-gradient(180deg,#000 0 29%,#fff 29% 35%,#bb101c 35% 65%,#fff 65% 71%,#15853f 71%); }
  .mz-flag--europe { background:#21468b; }
  .mz-flag--europe:after { content:""; position:absolute; left:14px; top:8px; width:5px; height:5px; border-radius:50%; background:#ffcc28; box-shadow:8px 0 #ffcc28,-8px 0 #ffcc28,0 7px #ffcc28,0 -7px #ffcc28; }

  .mz-home-lab { padding-bottom:24px; }
  .mz-home-lab__panel {
    display:grid; grid-template-columns:1.02fr 1.55fr; overflow:hidden; border-radius:8px; min-height:300px;
    background:linear-gradient(90deg,#f7f9fb 0%,#eef3f9 100%); border:1px solid #e5ebf1;
  }
  .mz-home-lab__image { min-height:300px; background:url({{ 'medzuro-lab-trust.png' | asset_url }}) center / cover no-repeat; }
  .mz-home-lab__copy { position:relative; padding:38px 44px; min-width:0; }
  .mz-home-lab__copy h2 { margin:0; color:var(--mz-navy); font-size:35px; line-height:1.14; letter-spacing:0; font-weight:900; }
  .mz-home-lab__copy h2 span { color:var(--mz-green); }
  .mz-home-lab__copy p { margin:16px 0 0; max-width:575px; color:#26364e; line-height:1.7; font-size:14px; font-weight:600; }
  .mz-home-eurofins {
    position:absolute; top:45px; right:40px; width:180px; display:grid; grid-template-columns:38px 1fr; gap:0 8px; align-items:center;
    color:#18346f; text-transform:uppercase;
  }
  .mz-home-eurofins__mark {
    grid-row:1 / span 2; width:34px; height:34px; border-radius:50%;
    background:radial-gradient(circle at 50% 7px,#fb6b24 0 3px,transparent 4px),radial-gradient(circle at 15px 13px,#3155a4 0 3px,transparent 4px),radial-gradient(circle at 24px 16px,#3155a4 0 3px,transparent 4px),radial-gradient(circle at 13px 24px,#fb6b24 0 3px,transparent 4px),radial-gradient(circle at 25px 26px,#3155a4 0 3px,transparent 4px);
  }
  .mz-home-eurofins strong { font-size:28px; line-height:1; letter-spacing:0; text-transform:none; }
  .mz-home-eurofins small { margin-top:8px; color:#102240; font-size:12px; font-weight:900; line-height:1.25; }
  .mz-home-lab__checks { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:0; margin:32px 0 0; padding:0 230px 0 0; list-style:none; }
  .mz-home-lab__checks li { display:flex; flex-direction:column; gap:9px; padding:0 17px; color:var(--mz-navy); }
  .mz-home-lab__checks li:first-child { padding-left:0; }
  .mz-home-lab__checks li + li { border-left:1px solid #d4dce6; }
  .mz-home-lab__checks svg { width:28px; height:28px; }
  .mz-home-lab__checks strong { display:block; font-size:11px; font-weight:900; line-height:1.25; }
  .mz-home-lab__checks small { display:block; margin-top:5px; color:#33435a; font-size:10px; line-height:1.35; font-weight:600; }
  .mz-home-lab__link {
    position:absolute; right:44px; bottom:42px; min-width:128px; min-height:43px; display:inline-flex; align-items:center; justify-content:center;
    border:1px solid #7e8791; border-radius:4px; color:#1a2233 !important; font-size:12px; font-weight:900; text-transform:uppercase; text-decoration:none !important;
  }

  .mz-home-reviews { padding-bottom:22px; }
  .mz-home-review {
    position:relative; min-height:185px; display:flex; flex-direction:column; gap:11px; padding:28px 36px 24px;
    background:#fff; border:1px solid #dfe5ec; border-radius:8px; box-shadow:0 6px 20px rgba(11,27,51,.04);
  }
  .mz-home-review__quote { position:absolute; top:24px; left:22px; color:#adb5bd; font-size:35px; font-family:Georgia, serif; line-height:1; font-weight:700; }
  .mz-home-review p { margin:0; color:#15213a; font-size:13px; line-height:1.65; font-weight:700; }
  .mz-home-review__person { display:flex; align-items:center; gap:12px; margin-top:auto; }
  .mz-home-review__person strong { display:flex; flex-direction:column; color:#14203a; font-size:13px; line-height:1.3; }
  .mz-home-review__person small { margin-top:2px; color:#526175; font-size:11px; font-weight:700; }
  .mz-home-avatar { flex:0 0 auto; width:48px; height:48px; border-radius:50%; box-shadow:0 0 0 2px #fff,0 0 0 3px #d4dce4; }
  .mz-home-avatar--sea { background:linear-gradient(180deg,#7ec1df 0 40%,#f5f1d8 40% 50%,#2e8a50 50%); }
  .mz-home-avatar--lagoon { background:linear-gradient(180deg,#7ed5f1 0 45%,#fff 45% 50%,#0b91a4 50%); }
  .mz-home-avatar--sun { background:radial-gradient(circle at 54% 40%,#f8b331 0 13px,transparent 14px),linear-gradient(180deg,#f36b31 0 52%,#24221a 52%); }

  .mz-home-help { padding-bottom:18px; }
  .mz-home-help__list { grid-template-columns:1fr 1fr 1fr; padding:17px 44px; }
  .mz-home-help__list svg { color:#557d31; width:36px; height:36px; }
  .mz-home-help__list li:first-child svg,
  .mz-home-help__list li:nth-child(2) svg,
  .mz-home-help__list li:nth-child(3) svg { padding:10px; width:58px; height:58px; border:1px solid #d6decf; border-radius:50%; background:#fff; }
  .mz-home-help__list li:nth-child(2) svg { color:#6e409d; }
  .mz-home-help__list li:nth-child(3) svg { color:#5d3c19; }

  .mz-home-newsletter { padding-bottom:0; }
  .mz-home-newsletter__panel {
    display:grid; grid-template-columns:1fr 1.08fr; gap:28px; align-items:center; padding:19px 34px;
    background:var(--mz-navy); color:#fff; border-radius:8px;
  }
  .mz-home-newsletter__copy { display:flex; align-items:center; gap:17px; min-width:0; }
  .mz-home-newsletter__copy strong { max-width:455px; font-size:16px; line-height:1.35; font-weight:800; }
  .mz-home-newsletter__icon {
    flex:0 0 auto; width:50px; height:50px; border-radius:50%; display:grid; place-items:center; border:1px solid rgba(255,255,255,.55);
  }
  .mz-home-newsletter__icon svg { width:26px; height:26px; color:#fff; }
  .mz-home-newsletter__form { display:grid; grid-template-columns:1fr 160px; gap:12px; }
  .mz-home-newsletter__form input {
    min-height:47px; width:100%; border:0; border-radius:4px; padding:0 18px; background:#fff; color:#0b1832; font-size:13px;
  }
  .mz-home-newsletter__form button {
    min-height:47px; border:0; border-radius:4px; background:#5d812d; color:#fff; font-size:12px; font-weight:900;
    text-transform:uppercase; letter-spacing:0;
  }

  .template-index .mz-foot {
    background:#fff !important; color:#111b34 !important; padding:24px 0 30px !important; border-top:0 !important;
  }
  .template-index .mz-foot a { color:#111b34 !important; }
  .template-index .mz-foot a:hover { color:#557d31 !important; }
  .template-index .mz-foot .page-width { max-width:1280px !important; padding-left:54px !important; padding-right:54px !important; }
  .template-index .mz-foot__top { grid-template-columns:1.1fr 2.6fr !important; gap:52px !important; padding-bottom:16px !important; }
  .template-index .mz-foot__brand { gap:9px !important; }
  .template-index .mz-foot__logo img { width:184px !important; max-width:184px !important; filter:none !important; }
  .template-index .mz-foot__blurb { color:#2d3a52 !important; font-size:12px !important; line-height:1.55 !important; max-width:260px !important; }
  .template-index .mz-foot__badge,
  .template-index .mz-foot__contact,
  .template-index .mz-foot__policies,
  .template-index .mz-foot__social { display:none !important; }
  .template-index .mz-foot__cols { grid-template-columns:repeat(3,minmax(0,1fr)) !important; gap:44px !important; }
  .template-index .mz-foot__ttl { color:#111b34 !important; font-size:12px !important; letter-spacing:0 !important; }
  .template-index .mz-foot__links { gap:6px !important; font-size:12px !important; color:#26364e !important; }
  .template-index .mz-foot__rte { color:#26364e !important; font-size:12px !important; line-height:1.6 !important; }
  .template-index .mz-foot__col--wide { display:none !important; }
  .template-index .mz-foot__bottom { border:0 !important; padding-top:0 !important; justify-content:flex-start !important; }
  .template-index .mz-foot__copy { color:#26364e !important; font-size:12px !important; }
  .template-index .mz-foot__pay { gap:8px !important; }
  .template-index .mz-foot__payicon { width:42px !important; height:26px !important; }

  @media (max-width:1180px) {
    .template-index #siteNav { gap:10px !important; }
    .template-index .header-logo { flex-basis:220px !important; min-width:220px !important; max-width:220px !important; }
    .template-index .header-logo img,
    .template-index .header-logo svg { width:198px !important; max-width:198px !important; }
    .mz-home-lab__checks { padding-right:0; }
    .mz-home-eurofins { position:static; margin-top:18px; width:auto; display:inline-grid; }
    .mz-home-lab__link { position:static; margin-top:24px; }
  }
  @media (max-width:1024px) {
    .template-index .top-header { padding:0 18px !important; }
    .template-index #header .site-header { min-height:66px !important; padding:0 18px !important; }
    .template-index .header-logo { flex:1 1 auto !important; min-width:0 !important; max-width:none !important; }
    .template-index .header-logo img,
    .template-index .header-logo svg { width:170px !important; max-width:170px !important; }
    .mz-home-ref .page-width { padding-left:18px; padding-right:18px; }
    .mz-home-hero,
    .mz-home-hero__wrap { min-height:650px; }
    .mz-home-hero__photo {
      background-image:linear-gradient(180deg, rgba(255,255,255,.98) 0%, rgba(255,255,255,.96) 42%, rgba(255,255,255,.15) 70%, rgba(255,255,255,0) 100%), url({{ 'medzuro-home-hero.png' | asset_url }});
      background-position:70% bottom; background-size:auto 60%;
    }
    .mz-home-hero__wrap { align-items:flex-start; }
    .mz-home-hero__copy { padding-top:48px; }
    .mz-home-hero__title { font-size:39px; }
    .mz-home-trust__list,
    .mz-home-help__list { grid-template-columns:1fr 1fr; padding:22px; gap:20px; }
    .mz-home-trust__list li + li,
    .mz-home-help__list li + li { border-left:0; padding-left:0; }
    .mz-home-products__track { grid-auto-columns:minmax(190px, 45%); }
    .mz-home-reviews__track { grid-auto-columns:minmax(270px, 74%); }
    .mz-home-world__panel { grid-template-columns:1fr; padding:30px 24px; }
    .mz-home-lab__panel { grid-template-columns:1fr; }
    .mz-home-lab__copy { padding:30px 24px; }
    .mz-home-lab__checks { grid-template-columns:1fr 1fr; gap:20px 0; }
    .mz-home-newsletter__panel { grid-template-columns:1fr; }
    .template-index .mz-foot .page-width { padding-left:24px !important; padding-right:24px !important; }
    .template-index .mz-foot__top { grid-template-columns:1fr !important; gap:26px !important; }
  }
  @media (max-width:640px) {
    .template-index .top-header .left-hdr,
    .template-index .top-header .right-hdr { display:none !important; }
    .template-index .top-header .middle-hdr { text-align:center !important; }
    .mz-home-hero,
    .mz-home-hero__wrap { min-height:620px; }
    .mz-home-hero__title { font-size:34px; }
    .mz-home-hero__text { font-size:15px; }
    .mz-home-btn { width:100%; }
    .mz-home-trust__list,
    .mz-home-help__list { grid-template-columns:1fr; }
    .mz-home-products__track { grid-auto-columns:minmax(170px, 78%); }
    .mz-home-product__media { min-height:170px; }
    .mz-home-world__stats { grid-template-columns:1fr; gap:18px; text-align:left; }
    .mz-home-world__stats div { align-items:flex-start; text-align:left; padding:0; }
    .mz-home-world__stats div + div { border-left:0; border-top:1px solid #d8dedf; padding-top:18px; }
    .mz-home-flags { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .mz-home-lab__copy h2 { font-size:28px; }
    .mz-home-lab__checks { grid-template-columns:1fr; }
    .mz-home-lab__checks li { padding:0; }
    .mz-home-lab__checks li + li { border-left:0; border-top:1px solid #d4dce6; padding-top:18px; }
    .mz-home-newsletter__form { grid-template-columns:1fr; }
    .template-index .mz-foot__cols { grid-template-columns:1fr 1fr !important; }
  }
</style>

{% schema %}
{
  "name": "Medzuro reference home",
  "tag": "section",
  "class": "mz-home-ref-section",
  "max_blocks": 30,
  "settings": [
    { "type": "header", "content": "Hero" },
    { "type": "text", "id": "hero_kicker", "label": "Hero eyebrow", "default": "Your wellness store in Fiji" },
    { "type": "text", "id": "hero_heading", "label": "Hero heading", "default": "Your wellness store," },
    { "type": "text", "id": "hero_accent", "label": "Hero accent", "default": "right here in Fiji." },
    { "type": "textarea", "id": "hero_text", "label": "Hero text", "default": "Genuine HolyOak supplements, available locally with same-day delivery across most of Suva and local pickup." },
    { "type": "text", "id": "primary_label", "label": "Primary button", "default": "Shop all products" },
    { "type": "url", "id": "primary_url", "label": "Primary link", "default": "/collections/all" },
    { "type": "text", "id": "secondary_label", "label": "Secondary button", "default": "Local pickup & delivery" },
    { "type": "url", "id": "secondary_url", "label": "Secondary link" },

    { "type": "header", "content": "Products" },
    { "type": "text", "id": "products_title", "label": "Heading", "default": "Best Sellers" },
    { "type": "collection", "id": "collection", "label": "Best sellers collection" },
    { "type": "range", "id": "product_limit", "label": "Products shown", "min": 5, "max": 12, "step": 1, "default": 5 },
    { "type": "text", "id": "product_meta", "label": "Fallback pack size", "info": "Used when a product has no medzuro.serving metafield.", "default": "60 Capsules" },
    { "type": "checkbox", "id": "show_ratings", "label": "Show star ratings", "default": true },
    { "type": "text", "id": "add_label", "label": "Add to cart label", "default": "Add to cart" },
    { "type": "text", "id": "soldout_label", "label": "Sold out label", "default": "Sold out" },

    { "type": "header", "content": "Around the world" },
    { "type": "checkbox", "id": "show_world", "label": "Show this area", "default": true },
    { "type": "text", "id": "world_kicker", "label": "Eyebrow", "default": "HolyOak around the world" },
    { "type": "text", "id": "world_heading", "label": "Heading line 1", "default": "Trusted internationally." },
    { "type": "text", "id": "world_heading_2", "label": "Heading line 2", "default": "Now available locally in" },
    { "type": "text", "id": "world_accent", "label": "Heading accent", "default": "Fiji." },
