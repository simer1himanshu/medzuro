{%- liquid
  assign products_per_page = section.settings.products_per_page | default: 12
  assign sort_by = collection.sort_by | default: collection.default_sort_by
  assign collection_title = collection.title | default: 'Products'
  assign category_menu = linklists[section.settings.category_menu]
-%}

<section class="mz-collection-page" data-section-id="{{ section.id }}">
  <div class="mz-collection-hero">
    <div class="mz-collection-shell mz-collection-hero__inner">
      <div class="mz-collection-hero__copy">
        <p class="mz-collection-eyebrow">Medzuro Retail</p>
        <h1>{{ collection_title }}</h1>
        {%- if collection.description != blank -%}
          <div class="mz-collection-hero__description rte">{{ collection.description }}</div>
        {%- else -%}
          <p class="mz-collection-hero__description">
            Genuine wellness essentials, selected for Fiji and backed by friendly local support.
          </p>
        {%- endif -%}
        <div class="mz-collection-hero__actions">
          <a class="mz-collection-btn mz-collection-btn--primary" href="/collections/all">
            <span aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
            </span>
            Shop All
          </a>
          <a class="mz-collection-btn mz-collection-btn--secondary" href="/pages/contact">
            <span aria-hidden="true">
              <svg viewBox="0 0 24 24" role="img"><path d="M21 15a4 4 0 0 1-4 4H8l-5 3V7a4 4 0 0 1 4-4h10a4 4 0 0 1 4 4z"/></svg>
            </span>
            Ask Support
          </a>
        </div>
      </div>
      <div class="mz-collection-hero__media" aria-hidden="true">
        <img
          src="{{ 'medzuro-home-hero.png' | asset_url }}"
          alt=""
          width="880"
          height="620"
          loading="eager">
      </div>
    </div>
  </div>

  <div class="mz-collection-shell mz-collection-body">
    <div class="mz-collection-highlights" aria-label="Store highlights">
      <div class="mz-collection-highlight">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 7h11v8H3z"/><path d="M14 10h4l3 3v2h-7z"/><circle cx="7" cy="18" r="2"/><circle cx="17" cy="18" r="2"/></svg>
        <span>Delivered across Fiji</span>
      </div>
      <div class="mz-collection-highlight">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s7-5.2 7-12a7 7 0 0 0-14 0c0 6.8 7 12 7 12z"/><circle cx="12" cy="9" r="2.4"/></svg>
        <span>Local pickup available</span>
      </div>
      <div class="mz-collection-highlight">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l7 3v5c0 4.7-3 8.4-7 10-4-1.6-7-5.3-7-10V6z"/><path d="M9 12l2 2 4-5"/></svg>
        <span>Genuine HolyOak products</span>
      </div>
      <div class="mz-collection-highlight">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 13a8 8 0 0 1 16 0"/><path d="M4 13v3a3 3 0 0 0 3 3h1v-8H7a3 3 0 0 0-3 3z"/><path d="M20 13v3a3 3 0 0 1-3 3h-1v-8h1a3 3 0 0 1 3 3z"/></svg>
        <span>Fiji customer support</span>
      </div>
    </div>

    {%- if category_menu.links.size > 0 -%}
      <nav class="mz-collection-categories" aria-label="Product categories">
        {%- for link in category_menu.links -%}
          <a class="{% if link.active %}is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- paginate collection.products by products_per_page -%}
      <div class="mz-collection-toolbar">
        <div class="mz-collection-toolbar__title">
          <p class="mz-collection-eyebrow">Shop Wellness</p>
          <h2>
            {%- if paginate.items > 0 -%}
              Showing {{ paginate.current_offset | plus: 1 }}-{% if paginate.next %}{{ paginate.current_offset | plus: paginate.page_size }}{% else %}{{ paginate.items }}{% endif %} of {{ paginate.items }}
            {%- else -%}
              Best Sellers
            {%- endif -%}
          </h2>
        </div>

        {%- if collection.sort_options.size > 0 and paginate.items > 0 -%}
          <form class="mz-collection-sort" method="get">
            <label for="SortBy-{{ section.id }}">Sort</label>
            <select id="SortBy-{{ section.id }}" name="sort_by" onchange="this.form.submit()">
              {%- for option in collection.sort_options -%}
                <option value="{{ option.value | escape }}"{% if option.value == sort_by %} selected="selected"{% endif %}>{{ option.name | escape }}</option>
              {%- endfor -%}
            </select>
          </form>
        {%- endif -%}
      </div>

      {%- if collection.products.size > 0 -%}
        <div class="mz-product-grid">
          {%- for product in collection.products -%}
            {%- liquid
              assign product_url = product.url | within: collection
              assign variant_count = product.variants | size
              assign first_variant = product.selected_or_first_available_variant
              assign product_image = product.featured_image
              assign product_image_alt = product_image.alt | default: product.title | escape
            -%}
            <article class="mz-product-card">
              <a class="mz-product-card__media" href="{{ product_url }}" aria-label="{{ product.title | escape }}">
                {%- if product_image != blank -%}
                  {{ product_image | image_url: width: 700 | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 25vw, (min-width: 640px) 33vw, 50vw', widths: '240, 360, 520, 700', alt: product_image_alt }}
                {%- else -%}
                  <span class="mz-product-card__placeholder">
                    <img src="{{ 'medzuro-logo.png' | asset_url }}" alt="" loading="lazy" width="220" height="110">
                  </span>
                {%- endif -%}
                {%- if product.compare_at_price > product.price -%}
                  <span class="mz-product-card__sale">Sale</span>
                {%- endif -%}
              </a>

              <div class="mz-product-card__body">
                {%- if product.vendor != blank -%}
                  <p class="mz-product-card__vendor">{{ product.vendor }}</p>
                {%- endif -%}
                <h3><a href="{{ product_url }}">{{ product.title }}</a></h3>
                <div class="mz-product-card__price">
                  <span>{{ product.price | money }}</span>
                  {%- if product.compare_at_price > product.price -%}
                    <s>{{ product.compare_at_price | money }}</s>
                  {%- endif -%}
                </div>

                {%- if product.available -%}
                  {%- if variant_count > 1 -%}
                    <a class="mz-product-card__button" href="{{ product_url }}">Choose Options</a>
                  {%- else -%}
                    {%- form 'product', product, class: 'mz-product-card__form', novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                      <input type="hidden" name="id" value="{{ first_variant.id }}">
                      <button class="mz-product-card__button" type="submit" name="add">Add To Cart</button>
                    {%- endform -%}
                  {%- endif -%}
                {%- else -%}
                  <a class="mz-product-card__button mz-product-card__button--disabled" href="{{ product_url }}">Sold Out</a>
                {%- endif -%}
              </div>
            </article>
          {%- endfor -%}
        </div>

        {%- if paginate.pages > 1 -%}
          <nav class="mz-collection-pagination" role="navigation" aria-label="Pagination">
            {%- if paginate.previous -%}
              <a href="{{ paginate.previous.url }}" aria-label="Previous page">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6"/></svg>
              </a>
            {%- endif -%}
            {%- for part in paginate.parts -%}
              {%- if part.is_link -%}
                <a href="{{ part.url }}">{{ part.title }}</a>
              {%- else -%}
                <span class="{% if part.title == paginate.current_page %}is-current{% endif %}">{{ part.title }}</span>
              {%- endif -%}
            {%- endfor -%}
            {%- if paginate.next -%}
              <a href="{{ paginate.next.url }}" aria-label="Next page">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6"/></svg>
              </a>
            {%- endif -%}
          </nav>
        {%- endif -%}
      {%- else -%}
        {%- liquid
          assign fallback_titles = 'HolyOak Ashwagandha|HolyOak Shilajit|HolyOak Turmeric Curcumin|HolyOak Omega 3|HolyOak Multivitamin' | split: '|'
          assign fallback_types = '60 Capsules|60 Capsules|60 Capsules|60 Softgels|60 Tablets' | split: '|'
          assign fallback_prices = 'FJD $39.20|FJD $45.00|FJD $38.25|FJD $42.00|FJD $35.00' | split: '|'
          assign fallback_compare = 'FJD $49.00||FJD $45.00||' | split: '|'
          assign fallback_reviews = '128|96|78|84|112' | split: '|'
        -%}
        <div class="mz-product-grid mz-product-grid--dummy">
          {%- for fallback_title in fallback_titles -%}
            {%- liquid
              assign fallback_index = forloop.index0
              assign fallback_type = fallback_types[fallback_index]
              assign fallback_price = fallback_prices[fallback_index]
              assign fallback_old_price = fallback_compare[fallback_index]
              assign fallback_review = fallback_reviews[fallback_index]
            -%}
            <article class="mz-product-card mz-product-card--dummy">
              <a class="mz-product-card__media" href="/pages/contact" aria-label="{{ fallback_title | escape }}">
                {%- if forloop.index == 3 -%}<span class="mz-product-card__sale">15% off</span>{%- endif -%}
                <span class="mz-fallback-bottle mz-fallback-bottle--{{ forloop.index }}" aria-hidden="true"><span></span></span>
              </a>

              <div class="mz-product-card__body">
                <p class="mz-product-card__vendor">HolyOak</p>
                <h3><a href="/pages/contact">{{ fallback_title }}</a></h3>
                <p class="mz-product-card__meta">{{ fallback_type }}</p>
                <div class="mz-product-card__rating" aria-label="5 out of 5 stars">
                  <span aria-hidden="true">&#9733;&#9733;&#9733;&#9733;&#9733;</span>
                  <small>({{ fallback_review }})</small>
                </div>
                <div class="mz-product-card__price">
                  <span>{{ fallback_price }}</span>
                  {%- if fallback_old_price != blank -%}<s>{{ fallback_old_price }}</s>{%- endif -%}
                </div>
                <a class="mz-product-card__button" href="/pages/contact">Add To Cart</a>
              </div>
            </article>
          {%- endfor -%}
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

<style>
  .mz-collection-page {
    --mz-navy: #071c43;
    --mz-blue: #064caf;
    --mz-green: #5c7f2d;
    --mz-gold: #a36c21;
    --mz-line: #dfe7f1;
    --mz-soft: #f5f8fc;
    color: var(--mz-navy);
    background: #f7f9fc;
  }

  .mz-collection-page * {
    box-sizing: border-box;
    letter-spacing: 0;
  }

  .mz-collection-shell {
    width: min(1180px, calc(100% - 48px));
    margin: 0 auto;
  }

  .mz-collection-hero {
    overflow: hidden;
    background:
      linear-gradient(90deg, rgba(255,255,255,.98) 0%, rgba(255,255,255,.94) 48%, rgba(246,249,252,.75) 100%),
      #f7f9fc;
    border-bottom: 1px solid var(--mz-line);
  }

  .mz-collection-hero__inner {
    min-height: 360px;
    display: grid;
    grid-template-columns: minmax(0, .88fr) minmax(420px, 1.12fr);
    gap: 32px;
    align-items: center;
    padding: 46px 0 42px;
  }

  .mz-collection-eyebrow {
    margin: 0 0 9px;
    color: var(--mz-blue);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .mz-collection-hero h1 {
    margin: 0;
    color: var(--mz-navy);
    font-size: 44px;
    font-weight: 800;
    line-height: 1.08;
  }

  .mz-collection-hero__description {
    max-width: 500px;
    margin: 18px 0 0;
    color: #183156;
    font-size: 16px;
    line-height: 1.7;
  }

  .mz-collection-hero__actions,
  .mz-collection-empty__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 24px;
  }

  .mz-collection-btn {
    min-height: 48px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 13px 22px;
    border: 1px solid var(--mz-navy);
    border-radius: 6px;
    font-size: 13px;
    font-weight: 800;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;
    transition: transform .18s ease, background .18s ease, color .18s ease, border-color .18s ease;
  }

  .mz-collection-btn svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mz-collection-btn:hover {
    transform: translateY(-1px);
    text-decoration: none;
  }

  .mz-collection-btn--primary,
  .mz-collection-btn--primary:visited {
    background: var(--mz-navy);
    border-color: var(--mz-navy);
    color: #fff !important;
  }

  .mz-collection-btn--primary:hover,
  .mz-collection-btn--primary:focus {
    background: var(--mz-blue);
    border-color: var(--mz-blue);
    color: #fff !important;
  }

  .mz-collection-btn--secondary,
  .mz-collection-btn--secondary:visited {
    background: #fff;
    color: var(--mz-navy) !important;
  }

  .mz-collection-btn--secondary:hover,
  .mz-collection-btn--secondary:focus {
    background: #f5f8fc;
    border-color: var(--mz-blue);
    color: var(--mz-blue) !important;
  }

  .mz-collection-hero__media {
    align-self: stretch;
    min-height: 310px;
    position: relative;
  }

  .mz-collection-hero__media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
    object-position: right center;
  }

  .mz-collection-body {
    padding: 28px 0 58px;
  }

  .mz-collection-highlights {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: -52px 0 30px;
    position: relative;
    z-index: 2;
    background: #fff;
    border: 1px solid var(--mz-line);
    border-radius: 8px;
    box-shadow: 0 14px 34px rgba(7, 28, 67, .08);
  }

  .mz-collection-highlight {
    min-height: 96px;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 20px 22px;
    border-right: 1px solid var(--mz-line);
  }

  .mz-collection-highlight:last-child {
    border-right: 0;
  }

  .mz-collection-highlight svg {
    width: 34px;
    height: 34px;
    flex: 0 0 34px;
    fill: none;
    stroke: var(--mz-blue);
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .mz-collection-highlight span {
    color: var(--mz-navy);
    font-size: 13px;
    font-weight: 800;
    line-height: 1.35;
  }

  .mz-collection-categories {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 24px;
  }

  .mz-collection-categories a {
    display: inline-flex;
    align-items: center;
    min-height: 38px;
    padding: 9px 16px;
    border: 1px solid var(--mz-line);
    border-radius: 6px;
    background: #fff;
    color: var(--mz-navy);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }

  .mz-collection-categories a.is-active,
  .mz-collection-categories a:hover {
    border-color: var(--mz-blue);
    color: var(--mz-blue);
  }

  .mz-collection-toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 22px;
  }

  .mz-collection-toolbar__title h2 {
    margin: 0;
    color: var(--mz-navy);
    font-size: 26px;
    font-weight: 800;
    line-height: 1.2;
  }

  .mz-collection-sort {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .mz-collection-sort label {
    margin: 0;
    color: #354563;
    font-size: 13px;
    font-weight: 800;
    text-transform: uppercase;
  }

  .mz-collection-sort select {
    min-width: 190px;
    min-height: 44px;
    border: 1px solid var(--mz-line);
    border-radius: 6px;
    background: #fff;
    color: var(--mz-navy);
    padding: 0 38px 0 14px;
    font-size: 14px;
    font-weight: 700;
  }

  .mz-product-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
  }

  .mz-product-grid--dummy {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  .mz-product-card {
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #fff;
    border: 1px solid var(--mz-line);
    border-radius: 8px;
    overflow: hidden;
    box-shadow: 0 12px 26px rgba(7, 28, 67, .06);
  }

  .mz-product-card__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    aspect-ratio: 1 / 1.05;
    background: #f2f6fa;
    padding: 18px;
    text-decoration: none;
  }

  .mz-product-card__media img {
    max-width: 100%;
    max-height: 100%;
    display: block;
    object-fit: contain;
    transition: transform .2s ease;
  }

  .mz-product-card:hover .mz-product-card__media img {
    transform: scale(1.025);
  }

  .mz-product-card__placeholder {
    width: 78%;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: .72;
  }

  .mz-product-card__sale {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 7px 9px;
    border-radius: 4px;
    background: var(--mz-green);
    color: #fff;
    font-size: 11px;
    font-weight: 900;
    line-height: 1;
    text-transform: uppercase;
  }

  .mz-product-card__body {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    padding: 17px 16px 16px;
  }

  .mz-product-card__vendor {
    margin: 0 0 7px;
    color: var(--mz-gold);
    font-size: 11px;
    font-weight: 900;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .mz-product-card__meta {
    margin: 8px 0 0;
    color: #23324a;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
  }

  .mz-product-card__rating {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-top: 9px;
    color: #111;
    font-size: 12px;
    line-height: 1;
  }

  .mz-product-card__rating span {
    color: #121212;
    letter-spacing: 0;
  }

  .mz-product-card__rating small {
    color: #14213c;
    font-size: 11px;
    font-weight: 800;
  }

  .mz-product-card h3 {
    min-height: 44px;
    margin: 0;
    color: var(--mz-navy);
    font-size: 15px;
    font-weight: 800;
    line-height: 1.45;
  }

  .mz-product-card h3 a {
    color: inherit;
    text-decoration: none;
  }

  .mz-product-card h3 a:hover {
    color: var(--mz-blue);
  }

  .mz-product-card__price {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    align-items: baseline;
    margin: 10px 0 16px;
    color: var(--mz-navy);
    font-size: 15px;
    font-weight: 900;
  }

  .mz-product-card__price s {
    color: #7b8797;
    font-size: 13px;
    font-weight: 700;
  }

  .mz-product-card__form {
    margin-top: auto;
  }

  .mz-product-card__button,
  .mz-product-card__button:visited {
    width: 100%;
    min-height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    margin-top: auto;
    border: 1px solid var(--mz-navy);
    border-radius: 6px;
    background: #fff;
    color: var(--mz-navy) !important;
    padding: 11px 14px;
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
  }

  .mz-product-card__button:hover,
  .mz-product-card__button:focus {
    background: var(--mz-navy);
    color: #fff !important;
    text-decoration: none;
  }

  .mz-fallback-bottle {
    position: relative;
    width: 70px;
    height: 150px;
    border-radius: 10px 10px 16px 16px;
    background: linear-gradient(90deg, #050405, #30231a 45%, #090909);
    box-shadow: inset 9px 0 12px rgba(255,255,255,.1), inset -9px 0 10px rgba(0,0,0,.34), 0 13px 18px rgba(11,27,51,.13);
  }

  .mz-fallback-bottle:before {
    content: "";
    position: absolute;
    left: 12px;
    right: 12px;
    top: -21px;
    height: 23px;
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(90deg, #050505, #202020, #050505);
  }

  .mz-fallback-bottle span {
    position: absolute;
    left: 8px;
    right: 8px;
    top: 40px;
    height: 68px;
    border-radius: 3px;
    background: #173927;
  }

  .mz-fallback-bottle span:after {
    content: "";
    position: absolute;
    left: 50%;
    top: 14px;
    width: 24px;
    height: 36px;
    border-left: 1px solid rgba(227,202,137,.95);
    border-radius: 50%;
    transform: translateX(-50%) rotate(-20deg);
  }

  .mz-fallback-bottle--1 span,
  .mz-fallback-bottle--3 span,
  .mz-fallback-bottle--5 span {
    background: #f8f7f1;
  }

  .mz-fallback-bottle--3:before {
    background: linear-gradient(90deg, #8b6030, #d9b476, #8b6030);
  }

  .mz-fallback-bottle--1 span:after,
  .mz-fallback-bottle--3 span:after,
