{%- comment -%} medzuro build file {%- endcomment -%}
{%- comment -%}
  Medzuro — product grid (spec §7).

  A quieter card than the theme default: image on a tinted panel, badges from
  the shared medzuro-product-badges snippet, then title, rating and price on a
  white footer. Renders nothing at all when the collection is empty, rather
  than leaving a hollow section on the page.
{%- endcomment -%}

{%- assign coll = collections[section.settings.collection] -%}
{%- assign limit = section.settings.limit -%}

{%- assign has_products = false -%}
{%- if coll != blank and coll.products_count > 0 -%}{%- assign has_products = true -%}{%- endif -%}

{%- assign show_ph = false -%}
{%- if has_products == false and section.settings.show_placeholders -%}{%- assign show_ph = true -%}{%- endif -%}

{%- if has_products or show_ph -%}
<div class="mz-prod section-{{ section.id }}">
  <div class="{% if section.settings.section_width == 'container' %}container{% endif %}">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="mz-prod__head">
        <div class="mz-prod__headtext">
          {%- if section.settings.title != blank -%}<h2 class="mz-prod__title">{{ section.settings.title }}</h2>{%- endif -%}
          {%- if section.settings.subtitle != blank -%}<p class="mz-prod__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
        </div>
        {%- if section.settings.show_viewall and has_products -%}
          <a class="mz-prod__viewall" href="{{ coll.url }}">
            {{ section.settings.viewall_text }}
            <svg width="22" height="10" viewBox="0 0 22 10" fill="none" aria-hidden="true" focusable="false">
              <path d="M0 5h19M15 1l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ul class="mz-prod__grid" role="list">
      {%- for product in coll.products limit: limit -%}
        {%- assign on_sale = false -%}
        {%- if product.compare_at_price > product.price -%}{%- assign on_sale = true -%}{%- endif -%}
        <li class="mz-prod__card">
          <a class="mz-prod__link" href="{{ product.url }}">
            <span class="mz-prod__media">
              {%- if product.featured_image != blank -%}
                {{ product.featured_image | image_url: width: 800 | image_tag:
                   loading: 'lazy', class: 'mz-prod__img',
                   widths: '300,450,600,800', sizes: '(max-width: 767px) 45vw, 24vw',
                   alt: product.featured_image.alt | default: product.title }}
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'mz-prod__img mz-prod__img--ph' }}
              {%- endif -%}
              <span class="product-labels mz-prod__labels">
                {% render 'medzuro-product-badges', product: product %}
                {%- if on_sale -%}<span class="lbl mz-prod__sale">{{ 'products.product.on_sale' | t }}</span>{%- endif -%}
              </span>
            </span>

            <span class="mz-prod__body">
              {%- if section.settings.show_vendor and product.vendor != blank -%}
                <span class="mz-prod__vendor">{{ product.vendor }}</span>
              {%- endif -%}
              <span class="mz-prod__name">{{ product.title }}</span>
              <span class="mz-prod__price">
                <span class="mz-prod__now{% if on_sale %} is-sale{% endif %}">{{ product.price | money }}</span>
                {%- if on_sale -%}<s class="mz-prod__was">{{ product.compare_at_price | money }}</s>{%- endif -%}
              </span>
              {%- unless product.available -%}
                <span class="mz-prod__stock">{{ 'products.product.sold_out' | t }}</span>
              {%- endunless -%}
            </span>
          </a>
        </li>
      {%- endfor -%}

      {%- if show_ph -%}
        {%- comment -%} Sample cards so the layout is visible before the catalogue exists. {%- endcomment -%}
        {%- assign ph_count = section.settings.columns | times: 2 -%}
        {%- for i in (1..ph_count) -%}
          {%- assign ph_n = i | modulo: 6 | plus: 1 -%}
          <li class="mz-prod__card mz-prod__card--ph">
            <span class="mz-prod__link">
              <span class="mz-prod__media">
                {{ 'product-' | append: ph_n | placeholder_svg_tag: 'mz-prod__img mz-prod__img--ph' }}
              </span>
              <span class="mz-prod__body">
                {%- if section.settings.show_vendor -%}<span class="mz-prod__vendor">HolyOak</span>{%- endif -%}
                <span class="mz-prod__name">{{ 'homepage.onboarding.product_title' | t }}</span>
                <span class="mz-prod__price"><span class="mz-prod__now">{{ 1999 | money }}</span></span>
              </span>
            </span>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

<style>
  .section-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; background: {{ section.settings.bg_color }}; }
  .section-{{ section.id }} .mz-prod__head { display:flex; align-items:flex-end; justify-content:space-between; gap:20px; margin-bottom:32px; flex-wrap:wrap; }
  .section-{{ section.id }} .mz-prod__headtext { display:flex; flex-direction:column; gap:6px; }
  .section-{{ section.id }} .mz-prod__title { margin:0; font-size:{{ section.settings.title_size }}px; line-height:1.15; color:{{ section.settings.title_color }}; }
  .section-{{ section.id }} .mz-prod__sub { margin:0; color:{{ section.settings.sub_color }}; }
  .section-{{ section.id }} .mz-prod__viewall {
    display:inline-flex; align-items:center; gap:8px; text-decoration:none; white-space:nowrap;
    font-weight:650; font-size:13px; letter-spacing:.06em; text-transform:uppercase; color:{{ section.settings.accent }};
  }
  .section-{{ section.id }} .mz-prod__viewall svg { transition:transform .3s cubic-bezier(.2,.7,.3,1); }
  .section-{{ section.id }} .mz-prod__viewall:hover svg { transform:translateX(4px); }

  .section-{{ section.id }} .mz-prod__grid {
    list-style:none; margin:0; padding:0; display:grid; gap:{{ section.settings.gap }}px;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0,1fr));
  }
  @media (min-width:768px) { .section-{{ section.id }} .mz-prod__grid { grid-template-columns: repeat({{ section.settings.columns }}, minmax(0,1fr)); } }

  .section-{{ section.id }} .mz-prod__card { display:flex; }
  .section-{{ section.id }} .mz-prod__link {
    display:flex; flex-direction:column; width:100%; text-decoration:none; color:inherit;
    background:{{ section.settings.card_bg }}; border:1px solid {{ section.settings.card_border }};
    border-radius:{{ section.settings.radius }}px; overflow:hidden;
    transition:border-color .25s ease, transform .3s cubic-bezier(.2,.7,.3,1);
  }
  .section-{{ section.id }} .mz-prod__link:hover { border-color:{{ section.settings.accent }}; transform:translateY(-4px); }
  .section-{{ section.id }} .mz-prod__link:focus-visible { outline:2px solid {{ section.settings.accent }}; outline-offset:3px; }

  .section-{{ section.id }} .mz-prod__media {
    position:relative; display:block; background:{{ section.settings.media_bg }};
    aspect-ratio:1/1; overflow:hidden;
  }
  .section-{{ section.id }} .mz-prod__img { width:100%; height:100%; object-fit:{{ section.settings.image_fit }}; padding:{% if section.settings.image_fit == 'contain' %}14%{% else %}0{% endif %}; transition:transform .5s cubic-bezier(.2,.7,.3,1); }
  .section-{{ section.id }} .mz-prod__link:hover .mz-prod__img { transform:scale(1.04); }
  .section-{{ section.id }} .mz-prod__labels { position:absolute; top:10px; left:10px; display:flex; flex-direction:column; gap:5px; align-items:flex-start; }
  .section-{{ section.id }} .mz-prod__sale { background:{{ section.settings.sale_color }}; }

  .section-{{ section.id }} .mz-prod__body { display:flex; flex-direction:column; gap:6px; padding:{{ section.settings.body_padding }}px; }
  .section-{{ section.id }} .mz-prod__vendor { font-size:11px; letter-spacing:.1em; text-transform:uppercase; font-weight:650; color:{{ section.settings.accent }}; }
  .section-{{ section.id }} .mz-prod__name { font-size:{{ section.settings.name_size }}px; font-weight:600; line-height:1.35; color:{{ section.settings.name_color }}; }
  .section-{{ section.id }} .mz-prod__price { display:flex; align-items:baseline; gap:8px; margin-top:2px; font-variant-numeric:tabular-nums; }
  .section-{{ section.id }} .mz-prod__now { font-size:{{ section.settings.price_size }}px; font-weight:700; color:{{ section.settings.price_color }}; }
  .section-{{ section.id }} .mz-prod__now.is-sale { color:{{ section.settings.sale_color }}; }
  .section-{{ section.id }} .mz-prod__was { font-size:{{ section.settings.price_size | minus: 3 }}px; color:{{ section.settings.sub_color }}; }
  .section-{{ section.id }} .mz-prod__stock { font-size:12px; font-weight:650; letter-spacing:.05em; text-transform:uppercase; color:{{ section.settings.sub_color }}; }

  .section-{{ section.id }} .mz-prod__card--ph .mz-prod__link { cursor:default; }
  .section-{{ section.id }} .mz-prod__card--ph .mz-prod__link:hover { transform:none; border-color:{{ section.settings.card_border }}; }
  .section-{{ section.id }} .mz-prod__img--ph { background:transparent; fill:{{ section.settings.sub_color }}; opacity:.28; padding:12%; }

  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .mz-prod__link,
    .section-{{ section.id }} .mz-prod__img,
    .section-{{ section.id }} .mz-prod__viewall svg { transition:none; }
    .section-{{ section.id }} .mz-prod__link:hover { transform:none; }
    .section-{{ section.id }} .mz-prod__link:hover .mz-prod__img { transform:none; }
  }
</style>
{%- endif -%}

{% schema %}
{
  "name": "Medzuro products",
  "tag": "section",
  "class": "mz-prod-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop the range" },
    { "type": "text", "id": "subtitle", "label": "Subheading" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "limit", "min": 2, "max": 16, "step": 1, "label": "Products shown", "default": 8 },
    { "type": "select", "id": "section_width", "label": "Width", "default": "container",
      "options": [{ "value": "container", "label": "Contained" }, { "value": "full", "label": "Full width" }] },
    { "type": "range", "id": "columns", "min": 2, "max": 5, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns (mobile)", "default": 2 },
    { "type": "range", "id": "gap", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Gap", "default": 20 },
    { "type": "checkbox", "id": "show_viewall", "label": "Show view-all link", "default": true },
    { "type": "text", "id": "viewall_text", "label": "View-all text", "default": "View all" },
    { "type": "checkbox", "id": "show_vendor", "label": "Show vendor", "default": true },
    { "type": "checkbox", "id": "show_placeholders", "label": "Show sample products when empty", "default": true,
      "info": "Draws example cards while the catalogue is being built. Turn this off before launch." },
    { "type": "header", "content": "Card" },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#e3e8ef" },
    { "type": "color", "id": "media_bg", "label": "Image panel", "default": "#f5f7fa" },
    { "type": "select", "id": "image_fit", "label": "Image fit", "default": "contain",
      "options": [
        { "value": "contain", "label": "Fit inside the panel" },
        { "value": "cover", "label": "Fill the panel" }
      ] },
    { "type": "range", "id": "radius", "min": 0, "max": 28, "step": 2, "unit": "px", "label": "Corner radius", "default": 14 },
    { "type": "range", "id": "body_padding", "min": 8, "max": 36, "step": 2, "unit": "px", "label": "Card text padding", "default": 20 },
    { "type": "header", "content": "Type" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#002964" },
    { "type": "color", "id": "title_color", "label": "Heading colour", "default": "#0b1b33" },
    { "type": "color", "id": "sub_color", "label": "Subheading colour", "default": "#5a6b82" },
    { "type": "color", "id": "name_color", "label": "Product name colour", "default": "#0b1b33" },
    { "type": "color", "id": "price_color", "label": "Price colour", "default": "#0b1b33" },
    { "type": "color", "id": "sale_color", "label": "Sale colour", "default": "#e30a1b" },
    { "type": "range", "id": "title_size", "min": 20, "max": 56, "step": 2, "unit": "px", "label": "Heading size", "default": 32 },
    { "type": "range", "id": "name_size", "min": 12, "max": 22, "step": 1, "unit": "px", "label": "Product name size", "default": 15 },
    { "type": "range", "id": "price_size", "min": 13, "max": 26, "step": 1, "unit": "px", "label": "Price size", "default": 17 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 5, "unit": "px", "label": "Padding top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 5, "unit": "px", "label": "Padding bottom", "default": 70 }
  ],
  "presets": [{ "name": "Medzuro products" }]
}
{% endschema %}
