    }

    .mz-pdp-difference-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .mz-pdp-shell {
      width: min(100% - 24px, 560px);
    }

    .mz-pdp-breadcrumb {
      font-size: 12px;
    }

    .mz-pdp-top {
      gap: 20px;
      padding-bottom: 34px;
    }

    .mz-pdp-gallery {
      grid-template-columns: 1fr;
    }

    .mz-pdp-thumbs {
      grid-template-columns: repeat(5, 1fr);
      grid-auto-rows: 70px;
      order: 2;
    }

    .mz-pdp-thumb {
      width: 100%;
      height: 70px;
    }

    .mz-pdp-main-media {
      min-height: 340px;
    }

    .mz-pdp-main-media img {
      max-height: 340px;
      padding: 20px;
    }

    .mz-pdp-trust-row,
    .mz-pdp-benefits,
    .mz-pdp-pack-grid,
    .mz-pdp-qty-row,
    .mz-pdp-service,
    .mz-pdp-difference-grid {
      grid-template-columns: 1fr;
    }

    .mz-pdp-buybox {
      padding: 18px;
    }

    .mz-pdp-buybox h1 {
      font-size: 28px;
    }

    .mz-pdp-section {
      padding: 34px 0;
    }

    .mz-pdp-section-head h2,
    .mz-pdp-purity__copy h2,
    .mz-pdp-inside__inner h2 {
      font-size: 26px;
    }

    .mz-pdp-solution-grid article {
      grid-template-columns: 56px minmax(0, 1fr);
      padding: 15px;
    }
  }
</style>

