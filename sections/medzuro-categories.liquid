{%- comment -%} medzuro build file {%- endcomment -%}
{%- comment -%}
  Medzuro — Shop by category (spec §7).

  Product cut-out sitting on a soft gradient disc, with an uppercase label and
  arrow beneath. Every tile's colours, image, label and link are block settings,
  so the section is fully editable in Admin (§32).

  Images should be PNG or WebP with a transparent background.
{%- endcomment -%}

<div class="mz-cats section-{{ section.id }}">
  <div class="{% if section.settings.section_width == 'container' %}page-width{% else %}fullwidth{% endif %}">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="mz-cats__head tc">
        {%- if section.settings.title != blank -%}<h2 class="mz-cats__title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.subtitle != blank -%}<p class="mz-cats__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <ul class="mz-cats__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <li class="mz-cats__item" {{ block.shopify_attributes }}>
          <a class="mz-cats__link" href="{{ b.url | default: '#' }}">
            <span class="mz-cats__disc" style="--c1:{{ b.color_from }};--c2:{{ b.color_to }};">
              {%- if b.image != blank -%}
                {{ b.image | image_url: width: 600 | image_tag:
                   loading: 'lazy', class: 'mz-cats__img',
                   widths: '300,450,600', sizes: '(max-width: 767px) 45vw, 22vw',
                   alt: b.title | default: '' }}
              {%- endif -%}
            </span>
            <span class="mz-cats__label">
              {{ b.title }}
              <svg class="mz-cats__arrow" width="26" height="10" viewBox="0 0 26 10" fill="none" aria-hidden="true" focusable="false">
                <path d="M0 5h23M19 1l5 4-5 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </span>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .section-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; background: {{ section.settings.bg_color }}; }
  .section-{{ section.id }} .mz-cats__head { margin-bottom: 34px; display:flex; flex-direction:column; gap:8px; }
  .section-{{ section.id }} .mz-cats__title { margin:0; font-size:{{ section.settings.title_size }}px; line-height:1.15; color:{{ section.settings.title_color }}; }
  .section-{{ section.id }} .mz-cats__sub { margin:0; color:{{ section.settings.sub_color }}; }
  .section-{{ section.id }} .mz-cats__grid {
    list-style:none; margin:0; padding:0; display:grid; gap:{{ section.settings.gap }}px;
    grid-template-columns: repeat({{ section.settings.columns_mobile }}, minmax(0,1fr));
  }
  @media (min-width:768px) { .section-{{ section.id }} .mz-cats__grid { grid-template-columns: repeat({{ section.settings.columns }}, minmax(0,1fr)); } }
  .section-{{ section.id }} .mz-cats__link { display:flex; flex-direction:column; align-items:center; gap:18px; text-decoration:none; color:inherit; }
  .section-{{ section.id }} .mz-cats__disc {
    position:relative; display:grid; place-items:center;
    width:100%; max-width:{{ section.settings.disc_max }}px; aspect-ratio:1/1;
    border-radius:50%; overflow:hidden;
    background:radial-gradient(circle at 50% 42%, var(--c1) 0%, var(--c2) 78%);
    transition: transform .35s cubic-bezier(.2,.7,.3,1);
  }
  {%- if section.settings.image_fit == 'cover' %}
  .section-{{ section.id }} .mz-cats__img { width:100%; height:100%; object-fit:cover; border-radius:50%; }
  {%- else %}
  .section-{{ section.id }} .mz-cats__img { width:{{ section.settings.image_scale }}%; height:{{ section.settings.image_scale }}%; object-fit:contain; }
  {%- endif %}
  .section-{{ section.id }} .mz-cats__label {
    display:inline-flex; align-items:center; gap:10px; font-weight:700;
    text-transform:uppercase; letter-spacing:.06em; font-size:{{ section.settings.label_size }}px;
    color:{{ section.settings.label_color }}; text-align:center;
  }
  .section-{{ section.id }} .mz-cats__arrow { transition: transform .35s cubic-bezier(.2,.7,.3,1); }
  .section-{{ section.id }} .mz-cats__link:hover .mz-cats__disc { transform: translateY(-6px); }
  .section-{{ section.id }} .mz-cats__link:hover .mz-cats__arrow { transform: translateX(5px); }
  .section-{{ section.id }} .mz-cats__link:focus-visible { outline:2px solid {{ section.settings.label_color }}; outline-offset:4px; border-radius:6px; }
  @media (prefers-reduced-motion: reduce) {
    .section-{{ section.id }} .mz-cats__disc,
    .section-{{ section.id }} .mz-cats__arrow { transition:none; }
    .section-{{ section.id }} .mz-cats__link:hover .mz-cats__disc { transform:none; }
    .section-{{ section.id }} .mz-cats__link:hover .mz-cats__arrow { transform:none; }
  }
</style>

{% schema %}
{
  "name": "Medzuro categories",
  "tag": "section",
  "class": "mz-cats-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Shop by category" },
    { "type": "text", "id": "subtitle", "label": "Subheading", "default": "Nutraceuticals, vitamins and wellness essentials" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "container",
      "options": [{ "value": "container", "label": "Contained" }, { "value": "full", "label": "Full width" }] },
    { "type": "range", "id": "columns", "min": 2, "max": 6, "step": 1, "label": "Columns (desktop)", "default": 4 },
    { "type": "range", "id": "columns_mobile", "min": 1, "max": 3, "step": 1, "label": "Columns (mobile)", "default": 2 },
    { "type": "range", "id": "gap", "min": 8, "max": 60, "step": 2, "unit": "px", "label": "Gap", "default": 28 },
    { "type": "range", "id": "disc_max", "min": 120, "max": 340, "step": 10, "unit": "px", "label": "Circle size", "default": 200 },
    { "type": "select", "id": "image_fit", "label": "Image style", "default": "cover",
      "options": [
        { "value": "cover", "label": "Photo fills the circle" },
        { "value": "contain", "label": "Cut-out on the circle" }
      ],
      "info": "Use \"Cut-out\" only for PNGs with a transparent background." },
    { "type": "range", "id": "image_scale", "min": 50, "max": 95, "step": 5, "unit": "%", "label": "Cut-out size", "default": 70 },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#ffffff" },
    { "type": "color", "id": "title_color", "label": "Heading colour", "default": "#0b1b33" },
    { "type": "color", "id": "sub_color", "label": "Subheading colour", "default": "#5a6b82" },
    { "type": "color", "id": "label_color", "label": "Label colour", "default": "#002964" },
    { "type": "range", "id": "title_size", "min": 20, "max": 56, "step": 2, "unit": "px", "label": "Heading size", "default": 32 },
    { "type": "range", "id": "label_size", "min": 11, "max": 22, "step": 1, "unit": "px", "label": "Label size", "default": 14 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 5, "unit": "px", "label": "Padding top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 5, "unit": "px", "label": "Padding bottom", "default": 70 }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "text", "id": "title", "label": "Label", "default": "Category" },
        { "type": "url", "id": "url", "label": "Link" },
        { "type": "image_picker", "id": "image", "label": "Product cut-out", "info": "PNG or WebP with a transparent background." },
        { "type": "color", "id": "color_from", "label": "Disc centre", "default": "#eef2f8" },
        { "type": "color", "id": "color_to", "label": "Disc edge", "default": "#dbe4f0" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Medzuro categories" }]
}
{% endschema %}
