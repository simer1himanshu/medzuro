{%- comment -%} medzuro build file {%- endcomment -%}
{%- comment -%}
  Medzuro — story rows.

  Alternating image-and-text rows for the about page. Each block is a row:
  eyebrow, heading, body, optional list of points and an optional button.
  Rows alternate sides automatically; a block can override that.

  A row with no image renders as full-width text, so it doubles as a
  statement or call-to-action row.
{%- endcomment -%}

{%- assign s = section.settings -%}

<div class="mz-story section-{{ section.id }}">
  <div class="{% if s.section_width == 'container' %}page-width{% else %}fullwidth{% endif %}">
    {%- if s.title != blank or s.subtitle != blank -%}
      <div class="mz-story__head tc">
        {%- if s.title != blank -%}<h2 class="mz-story__title">{{ s.title }}</h2>{%- endif -%}
        {%- if s.subtitle != blank -%}<p class="mz-story__sub">{{ s.subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="mz-story__rows">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- assign flip = false -%}
        {%- if b.side == 'right' -%}{%- assign flip = true -%}
        {%- elsif b.side == 'auto' -%}
          {%- assign mod = forloop.index0 | modulo: 2 -%}
          {%- if mod == 1 -%}{%- assign flip = true -%}{%- endif -%}
        {%- endif -%}

        <div class="mz-story__row{% if flip %} is-flip{% endif %}{% unless b.image != blank %} is-textonly{% endunless %}" {{ block.shopify_attributes }}>
          {%- if b.image != blank -%}
            <div class="mz-story__media">
              {{ b.image | image_url: width: 1200 | image_tag:
                 loading: 'lazy', class: 'mz-story__img',
                 widths: '400,600,800,1200', sizes: '(max-width: 899px) 92vw, 46vw',
                 alt: b.image.alt | default: b.heading }}
            </div>
          {%- endif -%}

          <div class="mz-story__text">
            {%- if b.eyebrow != blank -%}<span class="mz-story__eyebrow">{{ b.eyebrow }}</span>{%- endif -%}
            {%- if b.heading != blank -%}<h3 class="mz-story__h">{{ b.heading }}</h3>{%- endif -%}
            {%- if b.body != blank -%}<div class="mz-story__body rte">{{ b.body }}</div>{%- endif -%}

            {%- capture points -%}
              {%- for i in (1..4) -%}
                {%- assign pk = 'point' | append: i -%}
                {%- if b[pk] != blank -%}
                  <li>
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"
                         stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
                      <path d="m5 12.5 4.5 4.5L19 7"/>
                    </svg>
                    <span>{{ b[pk] }}</span>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if points != blank -%}<ul class="mz-story__points" role="list">{{ points }}</ul>{%- endif -%}

            {%- if b.btn_text != blank -%}
              <a class="mz-story__btn" href="{{ b.btn_url | default: '#' }}">{{ b.btn_text }}</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} { padding:{{ s.padding_top }}px 0 {{ s.padding_bottom }}px; background:{{ s.bg_color }}; }
  .section-{{ section.id }} .mz-story__head { margin-bottom:44px; display:flex; flex-direction:column; gap:8px; }
  .section-{{ section.id }} .mz-story__title { margin:0; font-size:{{ s.title_size }}px; line-height:1.15; color:{{ s.heading_color }}; }
  .section-{{ section.id }} .mz-story__sub { margin:0; color:{{ s.text_color }}; }

  .section-{{ section.id }} .mz-story__rows { display:flex; flex-direction:column; gap:{{ s.row_gap }}px; }
  .section-{{ section.id }} .mz-story__row { display:grid; gap:28px; grid-template-columns:1fr; align-items:center; }
  @media (min-width:900px) {
    .section-{{ section.id }} .mz-story__row { grid-template-columns:1fr 1fr; gap:{{ s.col_gap }}px; }
    .section-{{ section.id }} .mz-story__row.is-flip .mz-story__media { order:2; }
    .section-{{ section.id }} .mz-story__row.is-textonly { grid-template-columns:minmax(0,760px); justify-content:center; text-align:center; }
    .section-{{ section.id }} .mz-story__row.is-textonly .mz-story__points { display:inline-flex; flex-direction:column; text-align:left; }
  }

  .section-{{ section.id }} .mz-story__media { margin:0; }
  .section-{{ section.id }} .mz-story__img {
    width:100%; height:auto; display:block; border-radius:{{ s.radius }}px;
    aspect-ratio:{{ s.image_ratio }}; object-fit:cover; background:{{ s.media_bg }};
  }

  .section-{{ section.id }} .mz-story__text { display:flex; flex-direction:column; gap:14px; align-items:flex-start; }
  .section-{{ section.id }} .mz-story__row.is-textonly .mz-story__text { align-items:center; }
  .section-{{ section.id }} .mz-story__eyebrow { font-size:12px; font-weight:700; letter-spacing:.14em; text-transform:uppercase; color:{{ s.accent }}; }
  .section-{{ section.id }} .mz-story__h { margin:0; font-size:{{ s.row_heading_size }}px; line-height:1.2; color:{{ s.heading_color }}; }
  .section-{{ section.id }} .mz-story__body { color:{{ s.text_color }}; line-height:1.7; }
  .section-{{ section.id }} .mz-story__body p { margin:0 0 12px; }
  .section-{{ section.id }} .mz-story__body p:last-child { margin-bottom:0; }

  .section-{{ section.id }} .mz-story__points { list-style:none; margin:0; padding:0; display:flex; flex-direction:column; gap:10px; }
  .section-{{ section.id }} .mz-story__points li { display:flex; align-items:flex-start; gap:10px; color:{{ s.heading_color }}; line-height:1.5; }
  .section-{{ section.id }} .mz-story__points svg { width:19px; height:19px; flex:0 0 auto; margin-top:2px; color:{{ s.accent }}; }

  .section-{{ section.id }} .mz-story__btn {
    display:inline-block; margin-top:4px; padding:13px 26px; border-radius:{{ s.btn_radius }}px;
    background:{{ s.btn_bg }}; color:{{ s.btn_text }}; text-decoration:none; font-weight:650;
    transition:background .2s ease;
  }
  .section-{{ section.id }} .mz-story__btn:hover { background:{{ s.btn_bg_hover }}; }
  .section-{{ section.id }} .mz-story__btn:focus-visible { outline:2px solid {{ s.accent }}; outline-offset:3px; }
</style>

{% schema %}
{
  "name": "Medzuro story",
  "tag": "section",
  "class": "mz-story-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading" },
    { "type": "text", "id": "subtitle", "label": "Subheading" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "container",
      "options": [{ "value": "container", "label": "Contained" }, { "value": "full", "label": "Full width" }] },
    { "type": "select", "id": "image_ratio", "label": "Image shape", "default": "4/3",
      "options": [
        { "value": "4/3", "label": "Landscape" },
        { "value": "1/1", "label": "Square" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "16/9", "label": "Wide" }
      ] },
    { "type": "range", "id": "row_gap", "min": 30, "max": 120, "step": 5, "unit": "px", "label": "Space between rows", "default": 70 },
    { "type": "range", "id": "col_gap", "min": 20, "max": 100, "step": 4, "unit": "px", "label": "Image to text gap", "default": 56 },
    { "type": "range", "id": "radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Image corner radius", "default": 14 },
    { "type": "header", "content": "Colours" },
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#ffffff" },
    { "type": "color", "id": "media_bg", "label": "Image placeholder", "default": "#f5f7fa" },
    { "type": "color", "id": "accent", "label": "Accent", "default": "#002964" },
    { "type": "color", "id": "heading_color", "label": "Headings", "default": "#0b1b33" },
    { "type": "color", "id": "text_color", "label": "Body text", "default": "#5a6b82" },
    { "type": "color", "id": "btn_bg", "label": "Button background", "default": "#002964" },
    { "type": "color", "id": "btn_bg_hover", "label": "Button hover", "default": "#e30a1b" },
    { "type": "color", "id": "btn_text", "label": "Button text", "default": "#ffffff" },
    { "type": "range", "id": "btn_radius", "min": 0, "max": 30, "step": 2, "unit": "px", "label": "Button radius", "default": 8 },
    { "type": "header", "content": "Type and spacing" },
    { "type": "range", "id": "title_size", "min": 20, "max": 56, "step": 2, "unit": "px", "label": "Section heading size", "default": 34 },
    { "type": "range", "id": "row_heading_size", "min": 18, "max": 44, "step": 2, "unit": "px", "label": "Row heading size", "default": 26 },
    { "type": "range", "id": "padding_top", "min": 0, "max": 140, "step": 5, "unit": "px", "label": "Padding top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 140, "step": 5, "unit": "px", "label": "Padding bottom", "default": 70 }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Row",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty for a full-width text row." },
        { "type": "select", "id": "side", "label": "Image side", "default": "auto",
          "options": [
            { "value": "auto", "label": "Alternate" },
            { "value": "left", "label": "Left" },
            { "value": "right", "label": "Right" }
          ] },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Row heading" },
        { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Tell the story.</p>" },
        { "type": "text", "id": "point1", "label": "Point 1" },
        { "type": "text", "id": "point2", "label": "Point 2" },
        { "type": "text", "id": "point3", "label": "Point 3" },
        { "type": "text", "id": "point4", "label": "Point 4" },
        { "type": "text", "id": "btn_text", "label": "Button text" },
        { "type": "url", "id": "btn_url", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{ "name": "Medzuro story" }]
}
{% endschema %}
