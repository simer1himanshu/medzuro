  .mz-pdp-bottle,
  .mz-pdp-mini-bottle {
    position: relative;
    display: inline-block;
    border-radius: 10px 10px 16px 16px;
    background: linear-gradient(90deg, #050405, #30231a 45%, #090909);
    box-shadow: inset 9px 0 12px rgba(255,255,255,.1), inset -9px 0 10px rgba(0,0,0,.34), 0 13px 18px rgba(11,27,51,.13);
  }

  .mz-pdp-bottle--large {
    width: 154px;
    height: 318px;
  }

  .mz-pdp-bottle:before,
  .mz-pdp-mini-bottle:before {
    content: "";
    position: absolute;
    left: 18%;
    right: 18%;
    top: -14%;
    height: 15%;
    border-radius: 5px 5px 2px 2px;
    background: linear-gradient(90deg, #050505, #202020, #050505);
  }

  .mz-pdp-bottle span,
  .mz-pdp-mini-bottle span {
    position: absolute;
    left: 11%;
    right: 11%;
    top: 27%;
    height: 46%;
    border-radius: 3px;
    background: #173927;
  }

  .mz-pdp-bottle span:after,
  .mz-pdp-mini-bottle span:after {
    content: "";
    position: absolute;
    left: 50%;
    top: 18%;
    width: 38%;
    height: 54%;
    border-left: 1px solid rgba(227,202,137,.95);
    border-radius: 50%;
    transform: translateX(-50%) rotate(-20deg);
  }

  .mz-pdp-mini-bottle {
    width: 42px;
    height: 82px;
  }

  .mz-pdp-mini-bottle--1 span,
  .mz-pdp-mini-bottle--3 span,
  .mz-pdp-mini-bottle--5 span {
    background: #f8f7f1;
  }

  .mz-pdp-mini-bottle--3:before {
    background: linear-gradient(90deg, #8b6030, #d9b476, #8b6030);
  }

  .mz-pdp-mini-bottle--1 span:after,
  .mz-pdp-mini-bottle--3 span:after,
  .mz-pdp-mini-bottle--5 span:after {
    border-left-color: #a6a79a;
  }

  @media (max-width: 989px) {
    .mz-pdp-shell {
      width: min(100% - 32px, 780px);
    }

    .mz-pdp-top {
      grid-template-columns: 1fr;
    }

    .mz-pdp-buybox {
      position: static;
    }

    .mz-pdp-main-media {
      min-height: 460px;
    }

    .mz-pdp-usage-grid,
    .mz-pdp-solution-grid,
    .mz-pdp-review-grid,
    .mz-pdp-purity__inner,
    .mz-pdp-inside__inner {
