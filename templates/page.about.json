/*
 * Medzuro — About us.
 * Images are chosen in the theme editor; copy here is a starting draft and
 * every field is editable in Admin.
 */
{
  "sections": {
    "page": {
      "type": "page-template",
      "settings": {
        "section_width": "container",
        "breadcrumb": true
      }
    },
    "story": {
      "type": "medzuro-story",
      "blocks": {
        "r1": {
          "type": "row",
          "settings": {
            "side": "auto",
            "eyebrow": "Who we are",
            "heading": "Wellness, sold honestly",
            "body": "<p>Medzuro Retail is Fiji's premium nutraceutical and wellness retailer. We sell supplements, vitamins, minerals, herbal formulations and sports nutrition — nothing else.</p><p>We started because buying supplements in Fiji too often meant guessing: unclear labels, uncertain sourcing, and no way to tell an authentic product from a copy. We wanted a store where that guesswork was gone.</p>"
          }
        },
        "r2": {
          "type": "row",
          "settings": {
            "side": "auto",
            "eyebrow": "Authorized seller",
            "heading": "The official home of HolyOak in Fiji",
            "body": "<p>We are the authorized seller of HolyOak products in Fiji, importing directly from the manufacturer. Every product we list is traceable to its source.</p>",
            "point1": "Imported directly, never through third parties",
            "point2": "Batch numbers and expiry printed on every pack",
            "point3": "Sealed exactly as it left the manufacturer",
            "btn_text": "Shop HolyOak",
            "btn_url": "/collections/holyoak"
          }
        },
        "r3": {
          "type": "row",
          "settings": {
            "side": "auto",
            "eyebrow": "How we work",
            "heading": "Clear labels, careful handling",
            "body": "<p>Every product page lists the full ingredient breakdown, dosage and directions before you buy, not after it arrives. Orders are stored and packed so what reaches you is exactly what left our shelves.</p>",
            "point1": "Full ingredient and dosage information on every listing",
            "point2": "Careful storage and handling",
            "point3": "Packed to arrive undamaged"
          }
        }
      },
      "block_order": [
        "r1",
        "r2",
        "r3"
      ],
      "settings": {
        "section_width": "container",
        "image_ratio": "4/3",
        "bg_color": "#ffffff",
        "row_gap": 70,
        "col_gap": 56,
        "padding_top": 20,
        "padding_bottom": 70
      }
    },
    "values": {
      "type": "medzuro-features",
      "blocks": {
        "v1": {
          "type": "feature",
          "settings": {
            "icon": "shield",
            "title": "Authenticity first",
            "text": "<p>Authorized supply lines only. If we cannot trace it, we do not sell it.</p>"
          }
        },
        "v2": {
          "type": "feature",
          "settings": {
            "icon": "flask",
            "title": "Evidence over marketing",
            "text": "<p>We describe what a formulation contains, and leave the overclaiming to others.</p>"
          }
        },
        "v3": {
          "type": "feature",
          "settings": {
            "icon": "leaf",
            "title": "Wellness, not medicine",
            "text": "<p>We are a wellness retailer, not a pharmacy. For medical advice, speak to your doctor.</p>"
          }
        }
      },
      "block_order": [
        "v1",
        "v2",
        "v3"
      ],
      "settings": {
        "title": "What we stand for",
        "section_width": "container",
        "align": "center",
        "show_card": true,
        "bg_color": "#f5f7fa",
        "icon_size": 64,
        "radius": 14,
        "card_padding": 28,
        "padding_top": 70,
        "padding_bottom": 70
      }
    },
    "counters": {
      "type": "medzuro-counters",
      "blocks": {
        "c1": {
          "type": "counter",
          "settings": {
            "value": 22500,
            "suffix": "+",
            "label": "Products Sold"
          }
        },
        "c2": {
          "type": "counter",
          "settings": {
            "value": 3,
            "label": "Countries Served"
          }
        },
        "c3": {
          "type": "counter",
          "settings": {
            "value": 8000,
            "suffix": "+",
            "label": "Happy Customers"
          }
        }
      },
      "block_order": [
        "c1",
        "c2",
        "c3"
      ],
      "settings": {
        "title": "Trusted across Fiji",
        "style": "inverted",
        "section_width": "container",
        "dividers": true,
        "columns_mobile": 3,
        "value_size": 52,
        "label_size": 12,
        "padding_top": 70,
        "padding_bottom": 70
      }
    },
    "faq": {
      "type": "faq",
      "blocks": {
        "q1": {
          "type": "faqs",
          "settings": {
            "title": "Are you a pharmacy?",
            "answer": "<p>No. Medzuro Retail is a wellness and nutraceutical retailer. We do not dispense prescription medicine, offer consultations or book appointments.</p>"
          }
        },
        "q2": {
          "type": "faqs",
          "settings": {
            "title": "What does authorized seller mean?",
            "answer": "<p>It means HolyOak has appointed us to sell their products in Fiji. We import directly from the manufacturer rather than buying through resellers.</p>"
          }
        },
        "q3": {
          "type": "faqs",
          "settings": {
            "title": "Where do you deliver?",
            "answer": "<p>Across Fiji. Delivery times vary by location, and store pickup is available where we have a collection point.</p>"
          }
        },
        "q4": {
          "type": "faqs",
          "settings": {
            "title": "Can you advise which supplement I should take?",
            "answer": "<p>We can explain what a product contains and how the manufacturer recommends taking it. We cannot give medical advice — please speak to a qualified healthcare professional.</p>"
          }
        }
      },
      "block_order": [
        "q1",
        "q2",
        "q3",
        "q4"
      ],
      "settings": {
        "title": "About Medzuro",
        "subtitle": "Common questions about who we are and what we sell",
        "top-offeset": "none",
        "section_cov": true,
        "sec_bg_clr": "#ffffff",
        "pagestyle": "style1",
        "max-width": 800
      }
    },
    "cta": {
      "type": "medzuro-story",
      "blocks": {
        "cta1": {
          "type": "row",
          "settings": {
            "side": "auto",
            "eyebrow": "Start here",
            "heading": "Browse the range",
            "body": "<p>Genuine HolyOak products, with everything you need to know printed on the page.</p>",
            "btn_text": "Shop all products",
            "btn_url": "/collections/all"
          }
        }
      },
      "block_order": [
        "cta1"
      ],
      "settings": {
        "section_width": "container",
        "bg_color": "#f5f7fa",
        "padding_top": 60,
        "padding_bottom": 60
      }
    }
  },
  "order": [
    "page",
    "story",
    "values",
    "counters",
    "faq",
    "cta"
  ]
}
