{%- comment -%} medzuro build file {%- endcomment -%}
{%- comment -%}
  Medzuro — Why choose Medzuro (spec §7).

  Value propositions as cards, each with an inline SVG icon on a tinted disc.
  Icons are inline SVG rather than the theme icon font, so nothing depends on a
  glyph existing. All copy, icons and colours are block settings (§32).
{%- endcomment -%}

{%- capture icon_shield -%}<path d="M12 3 5 6v5.5c0 4.3 2.9 7.4 7 8.9 4.1-1.5 7-4.6 7-8.9V6l-7-3Z"/><path d="m9 12 2 2 4-4"/>{%- endcapture -%}
{%- capture icon_flask -%}<path d="M9 3h6"/><path d="M10 3v5.2L5.6 17A2 2 0 0 0 7.4 20h9.2a2 2 0 0 0 1.8-3L14 8.2V3"/><path d="M8 14.5h8"/>{%- endcapture -%}
{%- capture icon_award -%}<circle cx="12" cy="9" r="5"/><path d="m8.5 13.6-1.4 7 4.9-2.6 4.9 2.6-1.4-7"/>{%- endcapture -%}
{%- capture icon_leaf -%}<path d="M4 20C4 11.2 11.2 4 20 4c0 8.8-7.2 16-16 16Z"/><path d="M4 20c4.2-4.2 8.4-6.3 12.6-7.4"/>{%- endcapture -%}
{%- capture icon_truck -%}<path d="M3 7h10v8H3z"/><path d="M13 10h4l3 3.2V15h-7z"/><circle cx="7" cy="17.5" r="1.8"/><circle cx="16.5" cy="17.5" r="1.8"/>{%- endcapture -%}
{%- capture icon_check -%}<circle cx="12" cy="12" r="8.5"/><path d="m8.5 12 2.4 2.4 4.6-4.8"/>{%- endcapture -%}

<div class="mz-feat section-{{ section.id }}">
  <div class="{% if section.settings.section_width == 'container' %}container{% endif %}">
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <div class="mz-feat__head tc">
        {%- if section.settings.title != blank -%}<h2 class="mz-feat__title">{{ section.settings.title }}</h2>{%- endif -%}
        {%- if section.settings.subtitle != blank -%}<p class="mz-feat__sub">{{ section.settings.subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <ul class="mz-feat__grid" role="list">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        {%- case b.icon -%}
          {%- when 'flask' -%}{%- assign glyph = icon_flask -%}
          {%- when 'award' -%}{%- assign glyph = icon_award -%}
          {%- when 'leaf' -%}{%- assign glyph = icon_leaf -%}
          {%- when 'truck' -%}{%- assign glyph = icon_truck -%}
          {%- when 'check' -%}{%- assign glyph = icon_check -%}
          {%- else -%}{%- assign glyph = icon_shield -%}
        {%- endcase -%}
        <li class="mz-feat__item" {{ block.shopify_attributes }}>
          <span class="mz-feat__disc" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"
                 stroke-linecap="round" stroke-linejoin="round" focusable="false">{{ glyph }}</svg>
          </span>
          {%- if b.title != blank -%}<h3 class="mz-feat__ttl">{{ b.title }}</h3>{%- endif -%}
          {%- if b.text != blank -%}<div class="mz-feat__txt rte">{{ b.text }}</div>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>

<style>
  .section-{{ section.id }} { padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px; background: {{ section.settings.bg_color }}; }
  .section-{{ section.id }} .mz-feat__head { margin-bottom: 40px; display:flex; flex-direction:column; gap:8px; }
  .section-{{ section.id }} .mz-feat__title { margin:0; font-size:{{ section.settings.title_size }}px; line-height:1.15; color:{{ section.settings.title_color }}; }
  .section-{{ section.id }} .mz-feat__sub { margin:0; color:{{ section.settings.sub_color }}; }
  .section-{{ section.id }} .mz-feat__grid { list-style:none; margin:0; padding:0; display:grid; gap:{{ section.settings.gap }}px; grid-template-columns:1fr; }
  @media (min-width:768px) { .section-{{ section.id }} .mz-feat__grid { grid-template-columns: repeat({{ section.blocks.size | default: 3 }}, minmax(0,1fr)); } }
  .section-{{ section.id }} .mz-feat__item {
    display:flex; flex-direction:column;
    align-items:{% if section.settings.align == 'center' %}center{% else %}flex-start{% endif %};
    text-align:{% if section.settings.align == 'center' %}center{% else %}left{% endif %};
    gap:14px; padding:{{ section.settings.card_padding }}px;
    {% if section.settings.show_card %}background:{{ section.settings.card_bg }};border:1px solid {{ section.settings.card_border }};border-radius:{{ section.settings.radius }}px;{% endif %}
  }
  .section-{{ section.id }} .mz-feat__disc {
    display:grid; place-items:center; flex:0 0 auto;
    width:{{ section.settings.icon_size }}px; height:{{ section.settings.icon_size }}px;
    border-radius:50%; background:{{ section.settings.icon_bg }}; color:{{ section.settings.icon_color }};
  }
  .section-{{ section.id }} .mz-feat__disc svg { width:52%; height:52%; }
  .section-{{ section.id }} .mz-feat__ttl { margin:0; font-size:{{ section.settings.item_title_size }}px; line-height:1.3; font-weight:650; color:{{ section.settings.item_title_color }}; }
  .section-{{ section.id }} .mz-feat__txt { color:{{ section.settings.text_color }}; line-height:1.55; }
  .section-{{ section.id }} .mz-feat__txt p { margin:0; }
</style>

{% schema %}
{
  "name": "Medzuro features",
  "tag": "section",
  "class": "mz-feat-section",
  "settings": [
    { "type": "text", "id": "title", "label": "Heading", "default": "Why choose Medzuro" },
    { "type": "text", "id": "subtitle", "label": "Subheading" },
    { "type": "select", "id": "section_width", "label": "Width", "default": "container",
      "options": [{ "value": "container", "label": "Contained" }, { "value": "full", "label": "Full width" }] },
    { "type": "select", "id": "align", "label": "Alignment", "default": "center",
      "options": [{ "value": "center", "label": "Centred" }, { "value": "left", "label": "Left" }] },
    { "type": "header", "content": "Card" },
    { "type": "checkbox", "id": "show_card", "label": "Show card background", "default": true },
    { "type": "color", "id": "card_bg", "label": "Card background", "default": "#ffffff" },
    { "type": "color", "id": "card_border", "label": "Card border", "default": "#e3e8ef" },
    { "type": "range", "id": "radius", "min": 0, "max": 32, "step": 2, "unit": "px", "label": "Corner radius", "default": 14 },
    { "type": "range", "id": "card_padding", "min": 0, "max": 48, "step": 4, "unit": "px", "label": "Card padding", "default": 28 },
    { "type": "range", "id": "gap", "min": 8, "max": 48, "step": 2, "unit": "px", "label": "Gap", "default": 24 },
    { "type": "header", "content": "Icon" },
    { "type": "color", "id": "icon_bg", "label": "Icon disc", "default": "#eef2f8" },
    { "type": "color", "id": "icon_color", "label": "Icon colour", "default": "#002964" },
    { "type": "range", "id": "icon_size", "min": 40, "max": 96, "step": 4, "unit": "px", "label": "Icon disc size", "default": 64 },
    { "type": "header", "content": "Type" },
    { "type": "color", "id": "title_color", "label": "Heading colour", "default": "#0b1b33" },
    { "type": "color", "id": "sub_color", "label": "Subheading colour", "default": "#5a6b82" },
    { "type": "color", "id": "item_title_color", "label": "Card title colour", "default": "#0b1b33" },
    { "type": "color", "id": "text_color", "label": "Card text colour", "default": "#5a6b82" },
    { "type": "range", "id": "title_size", "min": 20, "max": 56, "step": 2, "unit": "px", "label": "Heading size", "default": 32 },
    { "type": "range", "id": "item_title_size", "min": 14, "max": 28, "step": 1, "unit": "px", "label": "Card title size", "default": 18 },
    { "type": "color", "id": "bg_color", "label": "Section background", "default": "#f5f7fa" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 120, "step": 5, "unit": "px", "label": "Padding top", "default": 70 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 120, "step": 5, "unit": "px", "label": "Padding bottom", "default": 70 }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        { "type": "select", "id": "icon", "label": "Icon", "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield with tick" },
            { "value": "check", "label": "Tick in circle" },
            { "value": "flask", "label": "Laboratory flask" },
            { "value": "award", "label": "Award" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "truck", "label": "Delivery" }
          ] },
        { "type": "text", "id": "title", "label": "Title", "default": "Feature" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Describe the benefit.</p>" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [{ "name": "Medzuro features" }]
}
{% endschema %}
